{
  "openapi": "3.1.0",
  "info": {
    "title": "Memory OS Import Security API",
    "version": "1.0.0",
    "description": "Security boundary for issuing, consuming and revoking exact-bound quarantine upload authorizations."
  },
  "servers": [
    { "url": "https://api.memory-os.example" }
  ],
  "tags": [
    { "name": "AppleAuth" },
    { "name": "ImportUpload" }
  ],
  "paths": {
    "/v1/auth/apple": {
      "post": {
        "tags": ["AppleAuth"],
        "operationId": "appleLogin",
        "summary": "Exchange a verified Apple identity for a Memory OS session.",
        "description": "Unauthenticated: this endpoint mints the session. The server verifies the identity token against Apple's keys, exchanges the authorization code server-side, enforces single-use nonce and code, and binds the account by issuer+subject. No account id or email in the body is trusted.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/AppleLoginRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Session issued.",
            "headers": { "Cache-Control": { "$ref": "#/components/headers/NoStore" } },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AppleLoginResponse" }
              }
            }
          },
          "400": {
            "description": "SEC_APPLE_LOGIN_REQUEST_INVALID: the request or identity token is malformed.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SafeError" } } }
          },
          "401": {
            "description": "SEC_APPLE_LOGIN_REJECTED: the identity or code did not verify, or a credential was replayed. One code, so the failing check cannot be probed.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SafeError" } } }
          },
          "409": {
            "description": "SEC_APPLE_ACCOUNT_CONFLICT: the Apple identity resolves to a non-active account; recovery is required rather than revival.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SafeError" } } }
          },
          "503": {
            "description": "SEC_SERVICE_UNAVAILABLE: Apple or a dependency was unavailable, or Apple login is not configured. Safe to retry.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SafeError" } } }
          }
        }
      }
    },
    "/v1/import-jobs/{jobId}/upload-authorizations": {
      "post": {
        "tags": ["ImportUpload"],
        "operationId": "createUploadAuthorization",
        "summary": "Issue a short-lived upload authorization bound to one import job and one exact object.",
        "security": [
          { "IOSAccessToken": [] },
          { "PairingAccessToken": [] }
        ],
        "parameters": [
          { "$ref": "#/components/parameters/JobId" },
          { "$ref": "#/components/parameters/IdempotencyKey" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateUploadAuthorizationRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Exact-bound authorization issued.",
            "headers": {
              "Cache-Control": { "$ref": "#/components/headers/NoStore" }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/CreateUploadAuthorizationResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/SafeError" },
          "401": { "$ref": "#/components/responses/SafeError" },
          "404": { "$ref": "#/components/responses/SafeNotFound" },
          "409": { "$ref": "#/components/responses/SafeError" },
          "413": { "$ref": "#/components/responses/SafeError" },
          "415": { "$ref": "#/components/responses/SafeError" },
          "429": { "$ref": "#/components/responses/SafeError" }
        },
        "x-memory-security": {
          "deriveOwnerFromVerifiedAuth": true,
          "deriveEpochFromServerAccount": true,
          "deriveObjectKeyOnServer": true,
          "pairingTokenMustMatchJobScope": true,
          "singleActiveAuthorizationPerIdempotencyKey": true,
          "responseContainsSensitiveSignedUrl": true,
          "logSignedUrl": false
        }
      }
    },
    "/v1/import-jobs/{jobId}/upload-authorizations/{uploadAuthorizationId}/complete": {
      "post": {
        "tags": ["ImportUpload"],
        "operationId": "completeUploadAuthorization",
        "summary": "Verify the exact quarantine object and consume the authorization.",
        "security": [
          { "IOSAccessToken": [] },
          { "PairingAccessToken": [] }
        ],
        "parameters": [
          { "$ref": "#/components/parameters/JobId" },
          { "$ref": "#/components/parameters/UploadAuthorizationId" },
          { "$ref": "#/components/parameters/IdempotencyKey" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CompleteUploadAuthorizationRequest" }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Storage metadata verified and quarantine scan queued.",
            "headers": {
              "Cache-Control": { "$ref": "#/components/headers/NoStore" }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/CompleteUploadAuthorizationResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/SafeError" },
          "401": { "$ref": "#/components/responses/SafeError" },
          "404": { "$ref": "#/components/responses/SafeNotFound" },
          "409": { "$ref": "#/components/responses/SafeError" },
          "410": { "$ref": "#/components/responses/SafeError" },
          "422": { "$ref": "#/components/responses/SafeError" }
        },
        "x-memory-security": {
          "trustClientObjectMetadata": false,
          "headExactServerGeneratedObjectKey": true,
          "compareStoredContentLength": true,
          "compareStoredChecksum": true,
          "compareStoredContentType": true,
          "compareStorageVersionWhenAvailable": true,
          "authorizationMustBeIssuedAndUnexpired": true,
          "authorizationConsumedAtomically": true,
          "cancelledOrDeletedAccountRejected": true,
          "queueOnlyAfterVerification": true
        }
      }
    },
    "/v1/import-jobs/{jobId}/upload-authorizations/{uploadAuthorizationId}": {
      "delete": {
        "tags": ["ImportUpload"],
        "operationId": "revokeUploadAuthorization",
        "summary": "Revoke an unused upload authorization.",
        "security": [
          { "IOSAccessToken": [] },
          { "PairingAccessToken": [] }
        ],
        "parameters": [
          { "$ref": "#/components/parameters/JobId" },
          { "$ref": "#/components/parameters/UploadAuthorizationId" }
        ],
        "responses": {
          "204": { "description": "Authorization revoked." },
          "401": { "$ref": "#/components/responses/SafeError" },
          "404": { "$ref": "#/components/responses/SafeNotFound" },
          "409": { "$ref": "#/components/responses/SafeError" }
        },
        "x-memory-security": {
          "sameOwnerRequired": true,
          "sameEpochRequired": true,
          "pairingTokenMustMatchJobScope": true,
          "alreadyConsumedCannotBeReopened": true,
          "objectCleanupScheduled": true
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "IOSAccessToken": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "opaque-or-jwt-server-session"
      },
      "PairingAccessToken": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "short-lived-upload-scoped-token"
      }
    },
    "parameters": {
      "JobId": {
        "name": "jobId",
        "in": "path",
        "required": true,
        "schema": { "$ref": "#/components/schemas/OpaqueId" }
      },
      "UploadAuthorizationId": {
        "name": "uploadAuthorizationId",
        "in": "path",
        "required": true,
        "schema": { "$ref": "#/components/schemas/OpaqueId" }
      },
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "minLength": 16,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:-]+$"
        }
      }
    },
    "headers": {
      "NoStore": {
        "description": "Sensitive responses must not be cached.",
        "schema": { "type": "string", "const": "no-store" }
      }
    },
    "schemas": {
      "AppleLoginRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["identityToken", "authorizationCode", "clientId", "nonce"],
        "description": "Client-supplied Apple material. Carries no account id and no email; every field is validated against Apple's signed token before it influences anything.",
        "properties": {
          "identityToken": { "type": "string", "maxLength": 16384, "description": "The Apple identity token (JWT) from the client." },
          "authorizationCode": { "type": "string", "maxLength": 4096, "description": "The single-use Apple authorization code, exchanged server-side." },
          "clientId": { "type": "string", "maxLength": 255, "description": "The Apple Services ID / client id; must equal the token audience." },
          "nonce": { "type": "string", "maxLength": 256, "description": "The expected nonce claim (already the client's sha256 per the Apple auth contract)." },
          "redirectUri": { "type": "string", "maxLength": 2048, "description": "Optional; when present, must match the code's original redirect." }
        }
      },
      "AppleLoginResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sessionToken", "accountId"],
        "description": "The issued session. No Apple material and no token internals are returned.",
        "properties": {
          "sessionToken": { "type": "string", "description": "Bearer token for subsequent authenticated requests." },
          "accountId": { "type": "string", "description": "The resolved Memory OS account id." }
        }
      },
      "OpaqueId": {
        "type": "string",
        "minLength": 16,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9._:-]+$"
      },
      "Sha256Hex": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      },
      "CreateUploadAuthorizationRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "contentLength",
          "checksumSha256Hex",
          "declaredContentType",
          "sourceSurface"
        ],
        "properties": {
          "contentLength": {
            "type": "integer",
            "minimum": 1,
            "maximum": 268435456
          },
          "checksumSha256Hex": { "$ref": "#/components/schemas/Sha256Hex" },
          "declaredContentType": {
            "type": "string",
            "enum": [
              "application/json",
              "text/csv",
              "text/tab-separated-values",
              "application/zip",
              "text/plain",
              "application/octet-stream"
            ]
          },
          "sourceSurface": {
            "type": "string",
            "enum": ["ios_file_intake", "desktop_import_portal"]
          },
          "originalFilename": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "description": "Untrusted display metadata. Never used as an object key and never written to ordinary logs."
          }
        }
      },
      "CreateUploadAuthorizationResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "uploadAuthorizationId",
          "uploadUrl",
          "method",
          "objectKey",
          "expiresAt",
          "requiredHeaders"
        ],
        "properties": {
          "uploadAuthorizationId": { "$ref": "#/components/schemas/OpaqueId" },
          "uploadUrl": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          },
          "method": { "type": "string", "const": "PUT" },
          "objectKey": {
            "type": "string",
            "pattern": "^quarantine/[A-Za-z0-9._:-]+/[A-Za-z0-9._:-]+$",
            "maxLength": 256
          },
          "expiresAt": { "type": "string", "format": "date-time" },
          "requiredHeaders": {
            "type": "object",
            "minProperties": 3,
            "maxProperties": 8,
            "additionalProperties": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "required": ["Content-Type", "Content-Length", "X-Content-SHA256"]
          }
        }
      },
      "CompleteUploadAuthorizationRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["clientUploadCompleted"],
        "properties": {
          "clientUploadCompleted": { "type": "boolean", "const": true }
        },
        "description": "The client does not submit authoritative object size, checksum, key, owner or epoch. The server retrieves those from the authorization and object storage."
      },
      "CompleteUploadAuthorizationResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["jobId", "uploadAuthorizationId", "quarantineObjectId", "status"],
        "properties": {
          "jobId": { "$ref": "#/components/schemas/OpaqueId" },
          "uploadAuthorizationId": { "$ref": "#/components/schemas/OpaqueId" },
          "quarantineObjectId": { "$ref": "#/components/schemas/OpaqueId" },
          "status": { "type": "string", "const": "quarantine_scan_queued" }
        }
      },
      "SafeError": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "requestId"],
        "properties": {
          "code": { "type": "string", "pattern": "^SEC_[A-Z0-9_]+$" },
          "requestId": { "$ref": "#/components/schemas/OpaqueId" }
        }
      }
    },
    "responses": {
      "SafeError": {
        "description": "Safe error without private object metadata.",
        "headers": {
          "Cache-Control": { "$ref": "#/components/headers/NoStore" }
        },
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/SafeError" }
          }
        }
      },
      "SafeNotFound": {
        "description": "Missing and cross-owner resources are intentionally indistinguishable.",
        "headers": {
          "Cache-Control": { "$ref": "#/components/headers/NoStore" }
        },
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/SafeError" }
          }
        }
      }
    }
  },
  "x-memory-security-boundary": {
    "cookiesUsed": false,
    "csrfByCookieSession": false,
    "clientProvidedOwnerAccepted": false,
    "clientProvidedEpochAccepted": false,
    "clientProvidedObjectKeyAccepted": false,
    "clientProvidedBucketAccepted": false,
    "signedUrlStoredInLogs": false,
    "signedUrlStoredInAnalytics": false,
    "rawFilenameUsedAsObjectKey": false,
    "crossOwnerLookupReturnsGenericNotFound": true,
    "storageBucketPublic": false,
    "storageListPermissionForClients": false,
    "objectMovesDirectlyToConfirmedStorage": false
  }
}
