    "preflightReadyNeverCreatesDrillRequest": true,
    "preflightBlockedCannotHaveCurrentExecutableDrillRequest": true,
    "currentExecutableDrillRequestRequiresReadyExistingPreflightDecision": true,
    "generationEvidenceRequiresRegisteredDrillRequest": true,
    "generationEvidenceRequestSourceGenerationMustMatch": true,
    "generationEvidenceRequestRestoreTargetGenerationMustMatch": true,
    "generationEvidenceRequestRecoveryObjectiveMustMatch": true,
    "newEvidenceRequiresCurrentlyExecutableDrillRequest": true,
    "historicalEvidenceMayRemainAuditableAfterDrillRequestStales": true,
    "staleRequestEvidenceCannotRemainCurrentCandidate": true,
    "generationBoundBackupCountMustBeRederivedFromImmutableEvidence": true,
    "generationBoundRestoreCountMustBeRederivedFromImmutableEvidence": true,
    "generationBoundBackupCountMustMatchBindingAuthority": true,
    "generationBoundRestoreCountMustMatchBindingAuthority": true,
    "recoveryAggregateOrderingMustRemainMonotonic": true,
    "typedCompleteCountMustBeRederivedFromValidatedEightDomainEvidence": true,
    "genericNonResurrectionPassCannotCreateFinalCandidate": true,
    "finalCandidateRequiresCompleteTypedEightDomainCoverage": true,
    "finalCandidateRequiresCurrentApprovedRecoveryObjective": true,
    "finalCandidateRequiresMeasuredObjectivesToPass": true,
    "finalCandidateRequiresIndependentSecurityAndOperabilityReview": true,
    "finalCandidateRequiresIndependentEvidenceReview": true,
    "finalCandidateCannotCompleteHumanProductionPromotionReview": true,
    "finalCandidateCannotAuthorizeProductionPromotion": true,
    "humanProductionPromotionReviewRemainsSeparate": true,
    "planningRequestCannotExecuteRestore": true,
    "chainCannotDeriveProductionEvidence": true,
    "chainCannotDeriveProductionReady": true,
    "canonicalOpsP0007SixBlockersMustRemainUntilRealEvidenceExists": true
  },
  "currentBoundary": {
    "preflightDecision": "BLOCKED_NEEDS_TWO_UNSUPERSEDED_DISTINCT_ENVIRONMENT_GENERATIONS",
    "preflightEligibleToSubmitReviewedDrillRequest": false,
    "preflightEligibleDirectedSourceTargetPairCount": 0,
    "reviewedDrillRequestCount": 0,
    "currentExecutableDrillRequestCount": 0,
    "generationEvidenceCount": 0,
    "drillRequestBoundGenerationEvidenceCount": 0,
    "generationBoundBackupCount": 0,
    "generationBoundRestoreCount": 0,
    "completeTypedNonResurrectionRecordCount": 0,
    "finalProductionEquivalentRecoveryCandidateCount": 0,
    "independentEvidenceReviewCompleted": false,
    "humanProductionPromotionReviewCompleted": false,
    "humanProductionPromotionAuthorized": false,
    "productionEvidence": false,
