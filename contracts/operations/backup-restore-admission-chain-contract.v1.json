{
  "contractId": "memory-os.operability.backup-restore-admission-chain.v1",
  "schemaVersion": "memory-os-backup-restore-admission-chain-contract.v1",
  "description": "End-to-end fail-closed invariant joining reviewed restore drill planning, drill-request-bound generation recovery evidence, typed non-resurrection evidence and final production-equivalent recovery candidate derivation. This contract validates authority composition only; it cannot create requests, execute restores, fabricate evidence or promote production readiness.",
  "drillRequestContract": "contracts/operations/backup-restore-drill-request-contract.v1.json",
  "drillRequestRegistry": "contracts/operations/backup-restore-drill-request-registry.v1.json",
  "generationEvidenceContract": "contracts/operations/backup-restore-generation-evidence-contract.v1.json",
  "generationEvidenceRegistry": "contracts/operations/backup-restore-generation-evidence-registry.v1.json",
  "typedNonResurrectionContract": "contracts/operations/backup-restore-non-resurrection-admission-contract.v1.json",
  "typedNonResurrectionRegistry": "contracts/operations/backup-restore-non-resurrection-admission-registry.v1.json",
  "operabilityInventory": "contracts/operations/operability-admission-inventory.v1.json",
  "operabilityStatus": "contracts/operations/production-operability-status.json",
  "validator": "scripts/validate-memory-os-backup-restore-admission-chain.py",
  "workflow": ".github/workflows/backup-restore-admission-chain.yml",
  "requiredChain": [
    "reviewedDrillRequest",
    "currentExecutableDrillRequestAtEvidenceAdmission",
    "drillRequestBoundGenerationEvidence",
    "preOverlayRecoveryGates",
    "typedNonResurrectionEightDomainCoverage",
    "finalProductionEquivalentRecoveryCandidate",
    "separateHumanProductionPromotionDecision"
  ],
  "invariants": {
    "generationEvidenceRequiresRegisteredDrillRequest": true,
    "generationEvidenceRequestSourceGenerationMustMatch": true,
    "generationEvidenceRequestRestoreTargetGenerationMustMatch": true,
    "generationEvidenceRequestRecoveryObjectiveMustMatch": true,
    "newEvidenceRequiresCurrentlyExecutableDrillRequest": true,
    "historicalEvidenceMayRemainAuditableAfterRequestStales": true,
    "staleRequestEvidenceCannotRemainCurrentCandidate": true,
    "genericNonResurrectionPassCannotCreateFinalCandidate": true,
    "finalCandidateRequiresCompleteTypedEightDomainCoverage": true,
    "finalCandidateRequiresCurrentApprovedRecoveryObjective": true,
    "finalCandidateRequiresMeasuredObjectivesToPass": true,
    "finalCandidateRequiresIndependentSecurityAndOperabilityReview": true,
    "planningRequestCannotExecuteRestore": true,
    "chainCannotDeriveProductionEvidence": true,
    "chainCannotDeriveProductionReady": true,
    "canonicalOpsP0007SixBlockersMustRemainUntilRealEvidenceExists": true
  },
  "currentBoundary": {
    "reviewedDrillRequestCount": 0,
    "currentExecutableDrillRequestCount": 0,
    "generationEvidenceCount": 0,
    "drillRequestBoundGenerationEvidenceCount": 0,
    "completeTypedNonResurrectionRecordCount": 0,
    "finalProductionEquivalentRecoveryCandidateCount": 0,
    "productionEvidence": false,
    "productionReady": false,
    "productionDecision": "NO_GO"
  }
}
