{
  "contractId": "memory-os.operability.sustained-soak-independent-review.v1",
  "schemaVersion": "memory-os-sustained-soak-independent-review.v1",
  "criteriaRecordSchemaVersion": "memory-os-sustained-soak-leak-stability-criteria.v1",
  "reviewRecordSchemaVersion": "memory-os-sustained-soak-independent-review-record.v1",
  "description": "Fail-closed admission contract for future human-approved leak/stability criteria and independent review. This contract does not define thresholds, does not create leak proof, and does not create production evidence.",
  "appendOnlyRegistry": true,
  "appendLockPath": "contracts/operations/.sustained-soak-independent-review.lock",
  "appendMustRevalidateCanonicalRegistryAndRollbackOnFailure": true,
  "criteriaAuthority": {
    "humanApprovedCriteriaRequired": true,
    "automaticCriteriaGenerationForbidden": true,
    "automaticThresholdSelectionForbidden": true,
    "criteriaMustBindExactRunIds": true,
    "criteriaMustBindExactRunEvidenceDigests": true,
    "criteriaMustDeclareMetricAndUnit": true,
    "criteriaMustDeclareDirectionAndAcceptanceRule": true,
    "criteriaMustDeclareReviewScope": true,
    "criteriaMustPreexistIndependentReview": true,
    "supersededCriteriaCannotRemainCurrentReviewAuthority": true,
    "approvalEvidenceMustBindCriteriaRecordDigest": true
  },
  "reviewAuthority": {
    "independentReviewerRequired": true,
    "criteriaApproverAndReviewerMustBeDistinct": true,
    "reviewMustBindApprovedCriteriaRecord": true,
    "reviewMustBindExactRunIds": true,
    "reviewMustBindExactRunEvidenceDigests": true,
    "atMostOneIndependentReviewPerCriteria": true,
    "onlyCurrentCriteriaPassCountsAsPassingIndependentReview": true,
    "descriptiveTrendReviewIsNotIndependentReview": true,
    "passingReviewDoesNotCreateProductionEvidence": true,
    "passingReviewDoesNotAuthorizeProductionPromotion": true,
    "independentReviewEvidenceMustBindReviewRecordDigest": true,
    "reviewOutcomeValues": [
      "PASS",
      "FAIL"
    ]
  },
  "recordAuthority": {
    "criteriaApprovalEvidenceDirectory": "docs/evidence/sustained-soak/criteria-approvals",
    "independentReviewEvidenceDirectory": "docs/evidence/sustained-soak/independent-reviews",
    "canonicalRunEvidenceDirectory": "docs/fixtures/memory-os-operability",
    "canonicalRunEvidenceGlob": "sustained-local-soak-results.run-*.v1.json",
    "criteriaApprovalEvidenceSchemaVersion": "memory-os-sustained-soak-criteria-approval.v2",
    "independentReviewEvidenceSchemaVersion": "memory-os-sustained-soak-independent-review-evidence.v2",
    "criteriaRequiredFields": [
      "schemaVersion",
      "criteriaId",
      "reviewScope",
      "runBindings",
      "criteria",
      "approvedAt",
      "approverPseudonym",
      "approvalEvidenceRef",
      "supersedesCriteriaId",
      "productionEvidence",
      "productionReady"
    ],
    "reviewRequiredFields": [
      "schemaVersion",
      "reviewId",
      "criteriaId",
      "runBindings",
      "reviewedAt",
      "reviewerPseudonym",
      "outcome",
      "findings",
      "reviewEvidenceRef",
      "productionEvidence",
      "productionReady"
    ],
    "runBindingRequiredFields": [
      "runId",
      "evidenceRef",
      "sha256"
    ],
    "criterionRequiredFields": [
      "metric",
      "unit",
      "direction",
      "acceptanceRule"
    ],
    "criteriaApprovalEvidenceRequiredFields": [
      "schemaVersion",
      "criteriaId",
      "criteriaRecordSha256",
      "decision",
      "approvedAt",
      "approverPseudonym",
      "productionTraffic",
      "productionCredentials",
      "automaticPromotion"
    ],
    "independentReviewEvidenceRequiredFields": [
      "schemaVersion",
      "reviewId",
      "criteriaId",
      "reviewRecordSha256",
      "outcome",
      "reviewedAt",
      "reviewerPseudonym",
      "productionTraffic",
      "productionCredentials",
      "automaticPromotion"
    ],
    "minimumBoundRuns": 2,
    "criteriaReviewScope": "LOCAL_LONG_SOAK_LEAK_STABILITY",
    "humanEvidenceMustUseDedicatedDirectory": true,
    "humanEvidenceMustBeTrackedAtHead": true,
    "humanEvidenceMustMatchHeadBlob": true,
    "humanEvidenceMustBeSymlinkFree": true,
    "runEvidenceMustBeCanonicalAndPerRunValidated": true,
    "runEvidenceMustBeTrackedAtHead": true,
    "runEvidenceMustMatchHeadBlob": true,
    "runEvidenceMustBeSymlinkFree": true,
    "runEvidenceDigestMustMatchBytes": true,
    "reviewRunBindingsMustExactlyMatchCriteria": true,
    "reviewerMustDifferFromCriteriaApprover": true,
    "reviewCannotPredateCriteriaApproval": true,
    "criteriaApprovalMustBindCanonicalRecordDigest": true,
    "independentReviewMustBindCanonicalRecordDigest": true,
    "productionEvidenceForbidden": true,
    "productionReadyForbidden": true
  },
  "promotionBoundary": {
    "localSustainedSoakEvidenceMaySatisfyReviewInput": true,
    "localSustainedSoakEvidenceAloneCreatesLeakProof": false,
    "emptyRegistryCreatesLeakProof": false,
    "automaticLeakProofForbidden": true,
    "automaticCapacityBoundaryPromotionForbidden": true,
    "automaticOperationalThresholdPromotionForbidden": true,
    "automaticProductionSoakPromotionForbidden": true,
    "productionEvidence": false,
    "productionReady": false
  },
  "registry": "contracts/operations/sustained-soak-independent-review-registry.v1.json",
  "validator": "scripts/validate-memory-os-sustained-soak-independent-review.py"
}
