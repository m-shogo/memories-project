{
  "contractId": "memory-os.operability.backup-restore-non-resurrection-admission.v1",
  "schemaVersion": "memory-os-backup-restore-non-resurrection-admission.v1",
  "recordSchemaVersion": "memory-os-backup-restore-non-resurrection-record.v1",
  "domainEvidenceRecordSchemaVersion": "memory-os-backup-restore-non-resurrection-domain-evidence.v1",
  "reviewEvidenceRecordSchemaVersion": "memory-os-backup-restore-non-resurrection-review-evidence.v1",
  "description": "Typed fail-closed overlay for generation-bound backup/restore admission. A generic nonResurrectionVerification=PASS claim is insufficient: every final production-equivalent recovery candidate must bind distinct evidence for deleted-account/session absence, expired and revoked session terminal semantics, Apple nonce/code replay rejection, deletion-lease continuity and idempotent restore effects. Every typed domain evidence document must itself bind the exact generation evidence, source commit, domain and result asserted by the overlay record. Independent SECURITY and OPERABILITY review documents must bind the exact typed record, generation, source commit, complete eight-domain evidence bundle, and the canonical SHA-256 digest of every reviewed domain evidence payload so a review cannot be reused after evidence content changes behind the same repository path. The typed record must additionally bind the canonical SHA-256 digest of each approved review payload, preventing later replacement of a review behind the same repository path from silently changing admitted authority. Reviews must use distinct pseudonymous reviewers. A generation record may satisfy all pre-overlay gates while remaining a non-candidate pending typed coverage. This overlay cannot derive production evidence or application production readiness.",
  "registry": "contracts/operations/backup-restore-non-resurrection-admission-registry.v1.json",
  "generationEvidenceRegistry": "contracts/operations/backup-restore-generation-evidence-registry.v1.json",
  "writer": "scripts/register-memory-os-backup-restore-non-resurrection-evidence.py",
  "validator": "scripts/validate-memory-os-backup-restore-non-resurrection-admission.py",
  "negativeAdmissionValidator": "scripts/validate-memory-os-backup-restore-non-resurrection-negative.py",
  "reconcile": "scripts/reconcile-memory-os-backup-non-resurrection-authority.py",
  "workflow": ".github/workflows/backup-restore-non-resurrection-admission.yml",
  "requiredRecordFields": [
    "schemaVersion",
    "recordId",
    "generationEvidenceId",
    "sourceCommitSha",
    "domains",
    "securityReviewRef",
    "securityReviewSha256",
    "operabilityReviewRef",
    "operabilityReviewSha256",
    "unresolvedFindings",
    "evidenceComplete",
    "productionTraffic",
    "productionCredentials",
    "productionEvidence",
    "productionReady"
  ],
  "requiredDomains": [
    "deletedAccountNonResurrection",
    "deletedSessionNonResolution",
    "expiredSessionTerminalSemantics",
    "revokedSessionTerminalSemantics",
    "appleNonceReplayRejected",
    "appleAuthorizationCodeReplayRejected",
    "deletionLeaseContinuity",
    "idempotentRestoreEffects"
  ],
  "recordRules": {
    "generationEvidenceMustExist": true,
    "generationEvidenceRegistryMustRemainAppendOnly": true,
    "generationEvidenceRegistryAggregateCountMustMatchRows": true,
    "generationEvidenceRegistryDerivedBackupRestoreCountsMustMatchRows": true,
    "generationEvidenceRegistryCandidateCountMustRespectRecoveryAggregateOrdering": true,
    "generationEvidenceRegistryProductionBoundaryMustRemainFalse": true,
    "sourceCommitMustMatchGenerationEvidence": true,
    "allRequiredDomainsMustBePresent": true,
    "allDomainsMustPassForEvidenceComplete": true,
    "eachDomainMustBindExistingRepositoryEvidence": true,
    "eachDomainEvidenceMustUseDomainEvidenceSchema": true,
    "eachDomainEvidenceMustMatchGenerationEvidenceId": true,
    "eachDomainEvidenceMustMatchSourceCommitSha": true,
    "eachDomainEvidenceMustMatchDomain": true,
    "eachDomainEvidenceResultMustMatchOverlayResult": true,
    "domainEvidenceProductionFlagsMustRemainFalse": true,
    "securityAndOperabilityReviewsMustBeDistinct": true,
    "reviewsMustUseTypedReviewEvidenceSchema": true,
    "reviewsMustMatchGenerationEvidenceId": true,
    "reviewsMustMatchSourceCommitSha": true,
    "reviewsMustMatchTypedRecordId": true,
    "reviewsMustBindExactEightDomainEvidenceBundle": true,
    "reviewsMustBindCanonicalDomainEvidenceSha256": true,
    "typedRecordMustBindCanonicalSecurityReviewSha256": true,
    "typedRecordMustBindCanonicalOperabilityReviewSha256": true,
    "securityAndOperabilityReviewersMustBeIndependent": true,
    "reviewsMustBeApproved": true,
    "reviewEvidenceProductionFlagsMustRemainFalse": true,
    "criticalOrHighOpenFindingsForbidden": true,
    "oneTypedRecordPerGenerationEvidenceId": true,
    "typedRegistryMustRemainAppendOnlyBeforeAppend": true,
    "typedRegistryAggregateCountsMustMatchRowsBeforeAppend": true,
    "typedRegistryExistingRowsMustRevalidateBeforeAppend": true,
    "typedRegistryCandidateCoveredCountMustBeRederivedBeforeAppend": true,
    "typedRegistryProductionBoundaryMustRemainFalseBeforeAppend": true,
    "typedRegistryMustRevalidateAfterAppendAndRollbackOnFailure": true,
    "productionTrafficForbidden": true,
    "productionCredentialsForbidden": true,
    "productionEvidenceForbidden": true,
    "productionReadyForbidden": true,
    "rawSecretsIdentifiersAndMutableAliasesForbidden": true
  },
  "candidateCoverageRule": {
    "genericNonResurrectionPassAloneIsInsufficient": true,
    "preOverlayEligibleRecordMayRemainPendingWithoutBecomingCandidate": true,
    "everyProductionEquivalentRecoveryCandidateRequiresOneCompleteTypedRecord": true,
    "completeTypedRecordRequiresTwoIndependentBundleAndDigestBoundApprovedReviews": true,
    "completeTypedRecordMustImmutablyBindBothReviewPayloadDigests": true,
    "typedRecordWithoutPreOverlayEligibilityDoesNotCreateCandidate": true,
    "productionPromotionStillRequiresSeparateHumanDecision": true
  },
  "localFoundationEvidence": {
    "appleReplayRestoreContract": "contracts/operations/local-apple-replay-restore-contract.v1.json",
    "appleReplayRestoreResult": "docs/fixtures/memory-os-operability/local-apple-replay-restore-results.sample.v1.json",
    "coherentRecoverySetContract": "contracts/operations/local-coherent-recovery-set-contract.v1.json",
    "coherentRecoverySetResult": "docs/fixtures/memory-os-operability/local-coherent-recovery-set-results.sample.v1.json",
    "localEvidenceMaySatisfyProductionEquivalentTypedRecord": false
  },
  "negativeAdmissionCases": [
    "unregistered generation evidence",
    "generation evidence registry aggregate count drift",
    "generation evidence registry drill-request-bound aggregate drift",
    "generation evidence registry complete backup aggregate drift",
    "generation evidence registry complete restore aggregate drift",
    "generation evidence registry boolean final candidate count",
    "generation evidence registry final candidate count exceeds restore aggregate",
    "generation evidence registry production boundary drift",
    "source commit mismatch",
    "missing required domain",
    "domain without evidence path",
    "domain result not PASS while evidenceComplete true",
    "security and operability review reuse",
    "security review generation binding mismatch",
    "operability review source commit binding mismatch",
    "review typed record binding mismatch",
    "review exact domain bundle mismatch",
    "review domain evidence digest binding mismatch",
    "security review payload digest binding mismatch",
    "operability review payload digest binding mismatch",
    "security and operability reviewer identity reuse",
    "review result not APPROVED",
    "HIGH or CRITICAL unresolved finding",
    "duplicate generation coverage",
    "typed writer registeredRecordCount drift before append",
    "typed writer boolean completeRecordCount before append",
    "typed writer candidateCoveredCount drift before append",
    "typed writer historical row schema mutation before append",
    "typed writer production boundary drift before append",
    "typed writer post-append validation failure must rollback registry",
    "production evidence relabel",
    "mutable latest alias",
    "domain evidence generation binding mismatch",
    "domain evidence source commit binding mismatch",
    "domain evidence domain binding mismatch",
    "domain evidence result binding mismatch",
    "generic generation record passing pre-overlay gates without typed overlay remains non-candidate"
  ],
  "currentBoundary": {
    "registeredTypedRecordCount": 0,
    "completeTypedRecordCount": 0,
    "productionEquivalentRecoveryCandidateCount": 0,
    "candidateCoveredCount": 0,
    "preOverlayEligiblePendingTypedCoverageCount": 0,
    "productionEquivalentNonResurrectionEvidence": false,
    "productionEvidence": false,
    "productionReady": false,
    "productionDecision": "NO_GO"
  },
  "readiness": {
    "contractDefined": true,
    "registryDefined": true,
    "writerImplemented": true,
    "validatorImplemented": true,
    "negativeAdmissionSuiteImplemented": true,
    "reconcileImplemented": true,
    "automaticWorkflowImplemented": true,
    "localAppleReplayRestoreProven": true,
    "localCoherentRecoverySetProven": true,
    "productionEquivalentCandidateAvailable": false,
