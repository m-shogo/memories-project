    "deletedSessionNonResolution": "docs/evidence/backup-restore/non-resurrection/deleted-session-",
    "expiredSessionTerminalSemantics": "docs/evidence/backup-restore/non-resurrection/expired-session-",
    "revokedSessionTerminalSemantics": "docs/evidence/backup-restore/non-resurrection/revoked-session-",
    "appleNonceReplayRejected": "docs/evidence/backup-restore/non-resurrection/apple-nonce-replay-",
    "appleAuthorizationCodeReplayRejected": "docs/evidence/backup-restore/non-resurrection/apple-code-replay-",
    "deletionLeaseContinuity": "docs/evidence/backup-restore/non-resurrection/deletion-lease-",
    "idempotentRestoreEffects": "docs/evidence/backup-restore/non-resurrection/idempotent-effects-"
  },
  "reviewEvidencePathPrefixes": {
