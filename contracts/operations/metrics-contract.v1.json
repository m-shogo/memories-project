{
  "contractId": "memory-os.operability.metrics-contract.v1",
  "schemaVersion": "memory-os-metrics.v1",
  "description": "Machine-readable runtime metrics contract for the import-api boundary. The validator checks this against the Go registry (metric names, types, required labels, histogram buckets, schema version and per-metric cardinality budgets), forbids any personal or high-cardinality label, requires a privacy classification and cardinality budget on every metric, requires each referenced SLI/SLO/alert to resolve, holds every SLO to PROPOSED-with-no-owner honesty and every alert to NOT_CONFIGURED until routing evidence exists, and forbids OPS-P0-004 READY until an exporter, scrape endpoint, dashboards, alert routing, retention and load evidence all exist. This contract defines the SLI base; it is not a running metrics stack.",
  "goImplementation": "services/import-api/internal/metrics",
  "goRecorderFile": "services/import-api/internal/metrics/recorder.go",
  "goLabelsFile": "services/import-api/internal/metrics/labels.go",
  "allowedTypes": [
    "counter",
    "gauge",
    "histogram"
  ],
  "allowedUnits": [
    "count",
    "seconds"
  ],
  "bucketsAreProvisional": true,
  "bucketProvisionalNote": "Histogram buckets are provisional: chosen before load evidence exists and to be re-tuned after OPS-P0-006 load testing. They are not derived from production data.",
  "forbiddenLabels": [
    "request_id",
    "correlation_id",
    "job_id",
    "account_id",
    "session_id",
    "apple_subject",
    "email",
    "ip",
    "ip_digest",
    "network_digest",
    "raw_url",
    "raw_path",
    "url",
    "path",
    "token",
    "bearer",
    "authorization",
    "filename",
    "object_key",
    "error",
    "sql",
    "query",
    "status_code",
    "user_agent",
    "forwarded_for",
    "preview_id",
    "upload_id"
  ],
  "labelValues": {
    "route_template": [
      "GET /healthz",
      "POST /v1/auth/apple",
      "DELETE /v1/account",
      "POST /v1/import-jobs/{jobId}/upload-authorizations",
      "POST /v1/import-jobs/{jobId}/upload-authorizations/{id}/complete",
      "GET /v1/import-jobs/{jobId}/preview",
      "POST /v1/previews/{previewId}/apply",
      "other"
    ],
    "route_class": [
      "PUBLIC_UNAUTHENTICATED",
      "PUBLIC_AUTHENTICATED",
      "HEALTH",
      "INTERNAL",
      "unknown"
    ],
    "method": [
      "GET",
      "POST",
      "DELETE",
      "other"
    ],
    "status_class": [
      "1xx",
      "2xx",
      "3xx",
      "4xx",
      "5xx",
      "unknown"
    ],
    "outcome": [
      "success",
      "failure",
      "rejected",
      "unknown"
    ],
    "failure_class": [
      "none",
      "authentication_failure",
      "authorization_denied",
      "invalid_request",
      "replay_rejected",
      "external_apple_failure",
      "database_unavailable",
      "object_store_unavailable",
      "parser_failure",
      "integrity_failure",
      "rate_limited",
      "store_unavailable",
      "deletion_retry",
      "deletion_terminal_failure",
      "internal_invariant_violation",
      "panic_recovered",
      "unknown"
    ],
    "provider": [
      "apple",
      "unknown"
    ],
    "policy_id": [
      "POST /v1/auth/apple",
      "DELETE /v1/account",
      "POST /v1/import-jobs/{jobId}/upload-authorizations",
      "POST /v1/import-jobs/{jobId}/upload-authorizations/{id}/complete",
      "GET /v1/import-jobs/{jobId}/preview",
      "POST /v1/previews/{previewId}/apply",
      "other",
      "unknown"
    ],
    "operation": [
      "apple_exchange",
      "session_issuance",
      "begin_deletion",
      "sweep",
      "resolve_session",
      "provision_identity",
      "presign",
      "head",
      "erase",
      "parse",
      "verify",
      "commit",
      "deletion_sweep",
      "unknown"
    ],
    "worker_name": [
      "deletion_runtime",
      "unknown"
    ]
  },
