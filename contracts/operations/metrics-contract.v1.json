  "alertCandidates": [
    {
      "id": "alert_http_5xx_burst",
      "sli": "sli_http_availability",
      "condition": "elevated 5xx ratio over a short window",
      "severity": "high",
      "routingStatus": "NOT_CONFIGURED",
      "runbook": null
    },
    {
      "id": "alert_panic_detected",
