      "id": "sli_http_availability",
      "description": "Fraction of HTTP requests that are not 5xx.",
      "goodEventQuery": "sum(rate(memory_os_http_requests_total{status_class!=\"5xx\"}[5m]))",
      "totalEventQuery": "sum(rate(memory_os_http_requests_total[5m]))",
