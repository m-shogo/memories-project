  "slos": [
    {
      "id": "slo_http_availability",
      "sli": "sli_http_availability",
      "status": "PROPOSED",
      "owner": "UNASSIGNED",
      "objective": "provisional: 99.5% non-5xx over 30d",
      "target": 0.995,
      "window": "30d",
      "basedOnData": false,
      "note": "Placeholder target; not calibrated against production load or an error-budget policy."
    },
    {
      "id": "slo_http_latency_p95",
      "sli": "sli_http_latency",
      "status": "PROPOSED",
      "owner": "UNASSIGNED",
      "objective": "provisional: p95 < 1s",
      "target": 1.0,
      "window": "30d",
      "basedOnData": false,
      "note": "Placeholder; buckets are provisional and unvalidated by load testing."
    },
    {
      "id": "slo_deletion_freshness",
      "sli": "sli_deletion_freshness",
      "status": "PROPOSED",
      "owner": "UNASSIGNED",
      "objective": "provisional: backlog drains within an operational window",
      "target": null,
      "window": "24h",
      "basedOnData": false,
      "note": "Placeholder; the right-to-erasure timeliness target needs a policy decision."
    }
