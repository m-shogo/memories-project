{
  "contractId": "memory-os.operability.release-compatibility-pair.v1",
  "schemaVersion": "memory-os-release-compatibility-pair.v1",
  "recordSchemaVersion": "memory-os-release-compatibility-pair-record.v1",
  "description": "Append-only admission authority for an explicitly reviewed predecessor/successor release pair. Candidate/local mixed-version evidence cannot create a pair. Both releases must already exist in the approved release baseline registry, the predecessor must be rollback-eligible, pair-specific rolling, rollback, persisted-route and database evidence must be committed, repository-contained and immutable by append-time digest binding, and independent review must be typed, pair-bound, role-separated and non-promoting.",
  "releaseRegistry": "contracts/operations/release-baseline-registry.v1.json",
  "registry": "contracts/operations/release-compatibility-pair-registry.v1.json",
  "appendLockPath": "contracts/operations/.release-compatibility-pair.lock",
  "writer": "scripts/register-memory-os-release-compatibility-pair.py",
  "validator": "scripts/validate-memory-os-release-compatibility-pair.py",
  "independentReviewValidator": "scripts/validate-memory-os-release-compatibility-pair-independent-review.py",
  "independentReviewNegativeValidator": "scripts/validate-memory-os-release-compatibility-pair-independent-review-negative.py",
  "independentReviewEvidenceRoot": "docs/evidence/release-compatibility-pairs/reviews",
  "reconcile": "scripts/reconcile-memory-os-release-compatibility-pair.py",
  "workflow": ".github/workflows/release-compatibility-pair.yml",
  "requiredRecordFields": [
    "schemaVersion",
    "pairId",
    "predecessorReleaseId",
    "predecessorCommitSha",
    "successorReleaseId",
    "successorCommitSha",
    "rollingDeploymentEvidenceRefs",
    "applicationRollbackEvidenceRefs",
    "persistedRouteEvidenceRefs",
    "databaseUpgradeEvidenceRefs",
    "artifactRetentionEvidenceRefs",
    "independentReviewRefs",
    "evidenceDigestsByField",
    "approvedAt",
    "openFindings",
    "pairEvidenceComplete",
    "productionEvidence",
    "productionReady"
  ],
  "rules": {
    "predecessorAndSuccessorMustBeDistinctApprovedReleases": true,
    "commitShasMustMatchApprovedReleaseRegistry": true,
    "predecessorRollbackEligibilityMustBeEligible": true,
    "candidateOrLocalEvidenceCannotSubstituteApprovedReleases": true,
    "rollingDeploymentEvidenceRequired": true,
    "applicationRollbackEvidenceRequired": true,
    "persistedRouteEvidenceRequired": true,
    "databaseUpgradeEvidenceRequired": true,
    "retainedArtifactEvidenceRequired": true,
    "exactlyTwoTypedIndependentReviewsRequired": true,
    "independentReviewRolesMustBeSecurityAndOperability": true,
    "independentReviewersMustBeDistinct": true,
    "independentReviewsMustBindPairAndReleaseIds": true,
    "independentReviewDecisionMustBeApproved": true,
    "independentReviewsCannotPostDatePairApproval": true,
    "independentReviewsCannotChangeProductionTrafficOrCredentials": true,
    "independentReviewsCannotAuthorizeAutomaticPromotion": true,
    "independentReviewRefsMustRemainUnderMonitoredEvidenceRoot": true,
    "evidenceRefsMustResolveWithinRepository": true,
    "evidencePathSymlinksForbidden": true,
    "evidenceRefsMustBeCommittedAtAdmission": true,
    "evidenceRefsMustBeAppendTimeDigestBound": true,
    "evidenceDigestReferenceSetsMustExactlyMatchRecordRefs": true,
    "evidenceBytesMustRemainEqualToAdmittedDigests": true,
    "appendLockMustRemainCanonical": true,
    "appendMustRevalidateCanonicalRegistryAndRollbackOnFailure": true,
    "criticalOrHighOpenFindingsForbidden": true,
    "pairEvidenceCompleteRequiredForAdmission": true,
    "productionEvidenceForbidden": true,
    "productionReadyForbidden": true
  },
  "currentAuthority": {
    "approvedPairCount": 0,
    "latestPairId": null,
    "rollbackEligiblePairCount": 0,
    "releaseCompatibilityEvidence": false,
    "productionEvidence": false,
    "productionReady": false,
    "productionDecision": "NO_GO"
  }
}
