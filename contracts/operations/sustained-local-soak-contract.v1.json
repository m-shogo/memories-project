{
  "contractId": "memory-os.operability.sustained-local-soak.v1",
  "schemaVersion": "memory-os-sustained-local-soak.v1",
  "resultsSchemaVersion": "memory-os-sustained-local-soak-results.v1",
  "description": "Fail-closed authority for repeated 60-minute-or-longer local stability runs. It is independent from the short CI stability sample and can never be promoted to production or production-equivalent evidence.",
  "scenarioId": "mixed-import-lifecycle-local-long-soak",
  "dependencyMode": "LOCAL_POSTGRES_MINIO",
  "classification": "LOCAL_LONG_SOAK",
  "minimumRunDurationSeconds": 3600,
  "minimumIndependentRuns": 2,
  "maximumSingleRunDurationSeconds": 5400,
  "windowCount": 12,
  "previewRequestsPerWindow": 64,
  "previewConcurrency": 8,
  "signedUploadLifecyclesPerWindow": 8,
  "signedUploadConcurrency": 4,
  "parserRecoveryRunsPerWindow": 1,
  "deletionCycleEveryWindows": 3,
  "maximumScanQueuePending": 128,
  "maximumDeletionPendingAfterWindow": 0,
  "maximumDeletionStuckAfterWindow": 0,
  "requiredCoverage": {
    "authenticatedPreviewRead": true,
    "signedUploadLifecycle": true,
    "parserSupervisor": true,
    "scanQueue": true,
    "deletionWorker": true,
    "postgresql": true,
    "minio": true
  },
  "requiredObservationsPerWindow": [
    "elapsedSeconds",
    "requestsBySurface",
    "successesBySurface",
    "failuresBySurface",
    "statusClassCountsBySurface",
    "latencyP50MsBySurface",
    "latencyP95MsBySurface",
    "latencyP99MsBySurface",
    "heapAllocBytes",
    "heapInuseBytes",
    "rssBytes",
    "goroutines",
    "dbPoolMaxConns",
    "dbPoolTotalConns",
    "dbPoolAcquiredConns",
    "dbPoolIdleConns",
    "dbPoolEmptyAcquireCount",
    "dbPoolCanceledAcquireCount",
    "dbPoolAcquireDurationMs",
    "scanQueuePending",
    "scanQueueOldestPendingSeconds",
    "deletionPending",
    "deletionStuck",
    "minioLifecycleSuccesses",
    "parserRuns",
    "parserFailures"
  ],
  "requiredTrendAnalysis": [
    "rss slope over elapsed minutes",
    "heap allocation slope over elapsed minutes",
    "heap-inuse slope over elapsed minutes",
    "goroutine slope over elapsed minutes",
    "p95 and p99 latency trend per surface",
    "error-rate trend per surface",
    "database connection and acquisition-wait trend",
    "scan queue depth and age trend",
    "deletion backlog depth and age trend"
  ],
  "successCriteriaForOneRun": {
    "durationAtLeastSeconds": 3600,
    "allRequiredCoverageExecuted": true,
    "noCrossTenantViolation": true,
    "noIntegrityViolation": true,
    "noUnexpected3xxOr4xx": true,
    "noUnclassified5xx": true,
    "noUnclassifiedTransportErrors": true,
    "scanQueueRemainsWithinBound": true,
    "deletionBacklogConvergesEachWindow": true,
    "postRunRecoveryProbe": true,
    "containsSecrets": false,
    "productionEvidence": false,
    "productionEquivalentDependencies": false
  },
  "promotionRules": {
    "onePassingRunIsLocalSustainedSoakEvidence": false,
    "minimumIndependentPassingRuns": 2,
    "allRequiredCoverageMustAppearInEveryPassingRun": true,
    "trendReviewRequired": true,
    "positiveSlopeIsNotAutomaticallyALeak": true,
    "flatSlopeIsNotLeakProof": true,
    "automaticLeakProofForbidden": true,
    "automaticOperationalThresholdPromotionForbidden": true,
    "automaticCapacityBoundaryPromotionForbidden": true,
    "automaticProductionSoakPromotionForbidden": true,
    "independentReviewRequiredForProductionPromotion": true
  },
  "abortCriteria": [
    "cross-tenant or account-epoch fencing invariant failure",
    "Preview, Apply, object-version, queue or deletion accounting divergence",
    "scan queue pending rows exceed 128 during the bounded run",
    "deletion backlog does not converge to zero after a deletion cycle",
    "post-run recovery probe fails",
    "result would persist a token, account identifier, raw object key, signed URL, local credential, database URL or user content",
    "non-loopback dependency endpoint is detected",
    "production traffic or production credentials are detected",
    "run exceeds the maximum bounded duration"
  ],
  "resultPathPattern": "docs/fixtures/memory-os-operability/sustained-local-soak-results.run-<n>.v1.json",
  "aggregateResultPath": "docs/fixtures/memory-os-operability/sustained-local-soak-results.aggregate.v1.json",
  "runner": "services/import-api/internal/httpserver/sustained_local_soak_test.go",
  "validator": "scripts/validate-memory-os-sustained-local-soak.py",
  "resultValidator": "scripts/validate-memory-os-sustained-local-soak-result.py",
  "aggregateValidator": "scripts/validate-memory-os-sustained-local-soak-aggregate.py",
  "reconcile": "scripts/reconcile-memory-os-sustained-local-soak-status.py",
  "workflow": ".github/workflows/sustained-local-soak.yml",
  "evidenceBoundary": {
    "syntheticDataOnly": true,
    "loopbackDependenciesOnly": true,
    "productionTraffic": false,
    "productionCredentials": false,
    "productionEvidence": false,
    "productionEquivalentDependencies": false,
    "productionSustainedSoakEvidence": false,
    "leakProof": false,
    "capacityBoundaryEstablished": false,
    "operationalThresholdApproved": false,
    "independentReviewCompleted": false,
    "productionReady": false
  },
  "readiness": {
    "contractDefined": true,
    "runnerImplemented": true,
    "validatorImplemented": true,
    "resultValidatorImplemented": true,
    "aggregateValidatorImplemented": true,
    "automaticWorkflowImplemented": true,
    "firstLongRunCommitted": true,
    "secondIndependentLongRunCommitted": true,
    "allRequiredCoverageExecuted": true,
    "trendReviewCompleted": true,
    "localSustainedSoakEvidence": true,
    "productionSustainedSoakEvidence": false,
    "leakProofAvailable": false,
    "capacityBoundaryEstablished": false,
    "operationalThresholdApproved": false,
    "independentReviewCompleted": false,
    "productionReady": false
  },
  "limitations": [
    "local PostgreSQL and MinIO remain materially different from production dependencies",
    "GitHub-hosted runner CPU, memory and noisy-neighbor behavior are ephemeral",
    "parser recovery is executed as a bounded Linux child test while API-process RSS and Go heap measure the long-lived HTTP process",
    "scan queue rows are intentionally accumulated only within a hard ceiling because the production scan worker topology is not present in this local fixture",
    "two passing local long runs still do not prove leak absence",
    "no production network, TLS, autoscaling, replica or external queue topology is exercised",
    "a local long-soak result cannot approve a production operating threshold"
  ]
}
