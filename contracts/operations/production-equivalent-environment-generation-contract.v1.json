{
  "contractId": "memory-os.operability.production-equivalent-environment-generation.v1",
  "schemaVersion": "memory-os-production-equivalent-environment-generation.v1",
  "description": "Fail-closed generation-binding authority for future production-equivalent environments. An environment identifier may be reused across rebuilds, but every material rebuild must create a new immutable generation identifier and evidence generated for one generation may never be reused for another.",
  "environmentRecordSchema": "contracts/operations/production-equivalent-environment-record.v1.schema.json",
  "generationRegistryRecordSchema": "contracts/operations/production-equivalent-environment-generation-record.v1.schema.json",
  "registry": "contracts/operations/production-equivalent-environment-generation-registry.v1.json",
  "writer": "scripts/register-memory-os-production-equivalent-environment-generation.py",
  "validator": "scripts/validate-memory-os-production-equivalent-environment-generation.py",
  "workflow": ".github/workflows/production-equivalent-environment-generation.yml",
  "bindingRules": {
    "generationIdRequired": true,
    "environmentManifestSha256Required": true,
    "dependencyInventorySha256Required": true,
    "evidenceBundleManifestSha256Required": true,
    "sourceCommitShaRequired": true,
    "materialDeltaLedgerSha256Required": true,
    "environmentRecordSha256Required": true,
    "restoreEvidenceGenerationMustMatch": true,
    "loadEvidenceGenerationMustMatch": true,
    "failureDrillGenerationMustMatch": true,
    "reviewEvidenceGenerationMustMatch": true,
    "crossGenerationEvidenceReuseForbidden": true,
    "mutableLatestAliasForbiddenAsEvidenceKey": true,
    "unknownGenerationFailsClosed": true,
    "appendOnlyRegistrationRequired": true,
    "supersededGenerationChainRequiredPerEnvironment": true
  },
  "materialChangeRules": {
    "postgresqlVersionOrTopologyChangeCreatesNewGeneration": true,
    "objectStoreEndpointOrLifecycleChangeCreatesNewGeneration": true,
    "runtimeRoleOrCredentialScopeChangeCreatesNewGeneration": true,
    "queueOrWorkerTopologyChangeCreatesNewGeneration": true,
    "networkTlsOrRoutingChangeCreatesNewGeneration": true,
    "backupRestoreTargetChangeCreatesNewGeneration": true,
    "containerImageOrExecutableDigestChangeCreatesNewGeneration": true,
    "configurationChangeAffectingCapacitySecurityOrRecoveryCreatesNewGeneration": true
  },
  "resultAdmissionRules": {
    "resultMustCarryGenerationId": true,
    "resultMustCarryEnvironmentManifestSha256": true,
    "resultMustCarrySourceCommitSha": true,
    "resultGenerationMustExistInRegistry": true,
    "resultManifestHashMustEqualRegisteredGeneration": true,
    "resultCreatedBeforeGenerationRegistrationRejected": true,
    "supersededGenerationEvidenceMayRemainHistoricalButCannotPromoteCurrentGeneration": true
  },
  "currentBoundary": {
    "registeredGenerationCount": 0,
    "currentGenerationId": null,
    "environmentProvisioned": false,
    "environmentValidated": false,
    "productionEquivalentDependencies": false,
    "productionEvidence": false,
    "productionReady": false,
    "productionDecision": "NO_GO"
  },
  "readiness": {
    "contractDefined": true,
    "registryDefined": true,
    "registryRecordSchemaDefined": true,
    "writerImplemented": true,
    "validatorImplemented": true,
    "automaticWorkflowImplemented": true,
    "generationRegistered": false,
    "generationEvidenceBound": false,
    "independentReviewCompleted": false,
    "productionEquivalentDependencies": false,
    "productionReady": false
  },
  "limitations": [
    "no production-equivalent environment generation is registered",
    "this contract prevents cross-generation evidence reuse but does not provision infrastructure",
    "a registered generation and hash match do not by themselves prove environment equivalence or production readiness",
    "production traffic and production credentials remain outside automatic evidence generation"
  ]
}
