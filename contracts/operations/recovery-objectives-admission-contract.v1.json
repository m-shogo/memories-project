{
  "contractId": "memory-os.operability.recovery-objectives-admission.v1",
  "schemaVersion": "memory-os-recovery-objectives-admission.v1",
  "recordSchemaVersion": "memory-os-recovery-objectives-record.v1",
  "description": "Append-only authority for explicitly human-approved recovery objectives. This contract does not choose RPO/RTO values; it only admits values supplied through distinct typed Recovery Owner and Operability approvals bound to the exact objective and prevents restore evidence from inventing or silently changing them.",
  "registry": "contracts/operations/recovery-objectives-registry.v1.json",
  "writer": "scripts/register-memory-os-recovery-objectives.py",
  "validator": "scripts/validate-memory-os-recovery-objectives.py",
  "negativeAdmissionValidator": "scripts/validate-memory-os-recovery-objectives-negative.py",
  "reconcile": "scripts/reconcile-memory-os-recovery-objectives.py",
  "workflow": ".github/workflows/recovery-objectives-admission.yml",
  "requiredRecordFields": [
    "schemaVersion",
    "objectiveId",
    "scope",
    "rpoSeconds",
    "rtoSeconds",
    "maximumObjectDatabaseSkewSeconds",
    "rpoMeasurementMethod",
    "rtoMeasurementMethod",
    "skewMeasurementMethod",
    "ownerRef",
    "approvalEvidenceRefs",
    "approvedAt",
    "supersedesObjectiveId",
    "productionEvidence",
    "productionReady"
  ],
  "rules": {
    "valuesMustBeExplicitPositiveIntegers": true,
    "objectDatabaseSkewMayBeZero": true,
    "measurementMethodsRequired": true,
    "measurementMethodsCannotBePlaceholderText": true,
    "ownerRequired": true,
    "ownerRefMustExistInRepository": true,
    "authorityRefsMustBeCanonicalRepositoryFiles": true,
    "exactlyTwoTypedApprovalEvidenceRefsRequired": true,
    "approvalEvidenceMustUseDedicatedAuthorityDirectory": true,
    "approvalEvidenceContentMustBeSha256BoundInRegistry": true,
    "approvalEvidenceDigestMapMustExactlyMatchRegisteredObjectives": true,
    "recoveryOwnerAndOperabilityApprovalRolesRequired": true,
    "approvalReviewersMustBeDistinct": true,
    "reviewerPseudonymsMustBeCanonicalNonEmptyText": true,
    "approvalDecisionMustBeApproved": true,
    "approvalMustBindObjectiveIdScopeRpoRtoAndSkew": true,
    "approvalCannotPostDateObjectiveApproval": true,
    "approvalCannotAuthorizeProductionTrafficCredentialsOrAutomaticPromotion": true,
    "ownerRefMustBeDistinctFromApprovalEvidenceRefs": true,
    "approvedAtMustBeUtcRfc3339Z": true,
    "appendOnlySupersessionRequired": true,
    "appendMustRevalidateCanonicalRegistryAndRollbackOnFailure": true,
    "implicitDefaultsForbidden": true,
    "mutableLatestAliasForbidden": true,
    "restoreEvidenceCannotOverrideObjectives": true,
    "rawUrlsSecretsAccountAndSessionIdentifiersForbidden": true,
    "productionEvidenceForbidden": true,
    "productionReadyForbidden": true
  },
  "negativeAdmissionCases": [
    "arbitrary repository files used as approval evidence",
    "absolute, parent-traversal or symlinked authority refs",
    "typed approval evidence content changed after registration",
    "approval evidence digest map missing, stale or contains unknown objectives",
    "typed approval bound to a different objectiveId",
    "typed approval bound to different RPO/RTO/skew values",
    "zero or negative RPO/RTO",
    "boolean RPO/RTO/skew values",
    "negative object-database skew",
    "placeholder measurement method",
    "missing owner evidence path",
    "owner evidence reused as independent approval evidence",
    "duplicate approval evidence refs",
    "missing approval evidence path",
    "approvedAt without UTC Z",
    "mutable latest alias",
    "production evidence relabel"
  ],
  "currentAuthority": {
    "approvedObjectiveCount": 0,
    "currentObjectiveId": null,
    "rpoDefined": false,
    "rtoDefined": false,
    "objectDatabaseSkewDefined": false,
    "productionEvidence": false,
    "productionReady": false,
    "productionDecision": "NO_GO"
  }
}
