{
  "contractId": "memory-os.operability.observability-event-contract.v1",
  "schemaVersion": "memory-os-observability-event.v1",
  "description": "Machine-readable contract for the structured observability events emitted by services/import-api. It is the single source of truth the validator checks the Go implementation against: the event-code set, the required and optional fields, the closed enumerations, the forbidden fields and the bounded-field policy must all match the code in internal/obslog. A drift between this file and the code is a CI failure, not a silent divergence.",
  "goImplementation": "services/import-api/internal/obslog",
  "requiredFields": [
    "schemaVersion",
    "timestamp",
    "severity",
    "eventName",
    "eventCode",
    "component",
    "outcome"
  ],
  "optionalFields": [
    "operation",
    "requestId",
    "correlationId",
    "jobId",
    "attemptId",
    "actorType",
    "httpMethod",
    "route",
    "statusCode",
    "durationMs",
    "retryable",
    "failureClass",
    "count"
  ],
  "boundedStringFields": {
    "operation": 64,
    "requestId": 128,
    "correlationId": 128,
    "jobId": 128,
    "attemptId": 64,
    "actorType": 64,
    "httpMethod": 64,
    "route": 128
  },
  "severity": [
    "debug",
    "info",
    "warn",
    "error"
  ],
  "outcome": [
    "success",
    "failure",
    "rejected"
  ],
  "failureClass": [
    "authentication_failure",
    "authorization_denied",
    "invalid_request",
    "replay_rejected",
    "external_apple_failure",
    "database_unavailable",
    "object_store_unavailable",
    "parser_failure",
    "integrity_failure",
    "rate_limited",
    "deletion_retry",
    "deletion_terminal_failure",
    "internal_invariant_violation",
    "panic_recovered"
  ],
  "component": [
    "http",
    "apple_auth",
    "upload",
    "preview",
    "apply",
    "deletion_worker",
    "import_flow",
    "server",
    "rate_limit"
  ],
  "eventCodes": [
    "OBS_SERVER_STARTED",
    "OBS_SERVER_STOPPING",
    "OBS_PANIC_RECOVERED",
    "OBS_INTERNAL_INVARIANT",
    "OBS_HTTP_REQUEST",
    "OBS_RATE_LIMIT_ALLOWED",
    "OBS_RATE_LIMIT_REJECTED",
    "OBS_RATE_LIMIT_STORE_UNAVAILABLE",
    "OBS_RATE_LIMIT_EMERGENCY_FALLBACK",
    "OBS_RATE_LIMIT_POLICY_INVALID",
    "OBS_RATE_LIMIT_KEY_CAPACITY_REJECTED",
    "OBS_APPLE_LOGIN",
    "OBS_UPLOAD_ISSUE",
    "OBS_UPLOAD_COMPLETE",
    "OBS_PREVIEW_READ",
    "OBS_APPLY",
    "OBS_IMPORT_FLOW",
    "OBS_DELETION_REQUESTED",
    "OBS_DELETION_CLAIMED",
    "OBS_DELETION_COMPLETED",
    "OBS_DELETION_RETRY",
    "OBS_DELETION_BACKLOG"
  ],
  "forbiddenFieldNames": [
    "message",
    "error",
    "err",
    "detail",
    "details",
    "attributes",
    "attrs",
    "body",
    "payload",
    "token",
    "bearer",
    "authorization",
    "sessionToken",
    "identityToken",
    "idToken",
    "accessToken",
    "refreshToken",
    "authorizationCode",
    "code",
    "nonce",
    "clientSecret",
    "privateKey",
    "password",
    "dsn",
    "email",
    "subject",
    "appleSubject",
    "accountId",
    "url",
    "presignedUrl",
    "signedUrl",
    "path",
    "sql",
    "sqlParams",
    "checksum",
    "title",
    "note",
    "content"
  ],
  "forbiddenFieldSubstrings": [
    "token",
    "secret",
    "password",
    "passwd",
    "bearer",
    "email",
    "nonce",
    "privatekey",
    "presign",
    "dsn"
  ],
  "privacyRules": {
    "noFreeFormMessageField": true,
    "noErrorValueField": true,
    "noMapEscapeHatch": true,
    "everyStringFieldBounded": true,
    "identifiersAreServerGeneratedNonSecret": true,
    "accountOrAppleSubjectNotUsedAsCorrelation": true
  },
  "retention": {
    "policyDefined": false,
    "note": "Log retention and access policy is deployment configuration and is NOT yet configured. This is one of the reasons OPS-P0-003 is not READY."
  },
  "alertRouting": {
    "routingConfigured": false,
    "note": "Real alert routing (paging/dashboards) is deployment configuration and is NOT yet configured. The deletion backlog event is emitted structured, but nothing routes it to an operator alerting system yet. This is the other reason OPS-P0-003 is not READY."
  }
}
