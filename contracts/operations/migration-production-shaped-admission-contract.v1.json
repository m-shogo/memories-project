{
  "contractId": "memory-os.operability.migration-production-shaped-admission.v1",
  "schemaVersion": "memory-os-migration-production-shaped-admission.v1",
  "description": "Thin admission layer that promotes an already-registered append-only migration rehearsal record into production-equivalent rehearsal evidence only when it is bound to an immutable environment generation, an approved predecessor/successor release pair, generation-consistent recovery evidence, mixed-version compatibility and independent review. It does not duplicate the migration evidence ledger and cannot manufacture a release, restore point or production readiness.",
  "sourceMigrationLifecycleContract": "contracts/operations/migration-lifecycle-contract.v1.json",
  "sourceMigrationEvidenceRegistryContract": "contracts/operations/migration-evidence-registry-contract.v1.json",
  "sourceReleaseRegistry": "contracts/operations/release-baseline-registry.v1.json",
  "sourceCompatibilityExecutionAuthority": "contracts/operations/version-compatibility-execution-evidence.v1.json",
  "environmentGenerationContract": "contracts/operations/production-equivalent-environment-generation-contract.v1.json",
  "environmentGenerationRegistry": "contracts/operations/production-equivalent-environment-generation-registry.v1.json",
  "backupRestoreGenerationContract": "contracts/operations/backup-restore-generation-binding-contract.v1.json",
  "registryPath": "contracts/operations/migration-production-shaped-admission-registry.v1.json",
  "writer": "scripts/register-memory-os-migration-production-shaped-admission.py",
  "validator": "scripts/validate-memory-os-migration-production-shaped-admission.py",
  "reconcile": "scripts/reconcile-memory-os-migration-production-shaped-admission.py",
  "workflow": ".github/workflows/migration-production-shaped-admission.yml",
  "recordSchemaVersion": "memory-os-migration-production-shaped-admission-record.v1",
  "requiredRecordFields": [
    "schemaVersion",
    "admissionId",
    "migrationEvidenceRef",
    "migrationRunId",
    "sourceCommitSha",
    "environmentGenerationId",
    "environmentManifestSha256",
    "predecessorReleaseId",
    "successorReleaseId",
    "compatibilityEvidenceRefs",
    "recoveryEvidenceRefs",
    "backfillRequired",
    "backfillEvidenceRefs",
    "mixedVersionObservationRefs",
    "securityReviewRef",
    "operabilityReviewRef",
    "unresolvedFindings",
    "evidenceComplete",
    "productionEvidence",
    "productionReady"
  ],
  "admissionRules": {
    "migrationEvidenceMustAlreadyExistInCanonicalLedger": true,
    "migrationEvidenceMustBeProductionEquivalentRehearsalClass": true,
    "migrationEvidenceSourceCommitMustMatchAdmission": true,
    "migrationEvidenceRecoveryArtifactMustBeVerified": true,
    "migrationEvidenceLockBudgetMustPass": true,
    "migrationEvidenceApplyAndVerificationMustPass": true,
    "environmentGenerationMustExist": true,
    "environmentManifestMustMatchRegisteredGeneration": true,
    "predecessorAndSuccessorMustBothBeApproved": true,
    "predecessorAndSuccessorMustBeDistinct": true,
    "mixedVersionCompatibilityEvidenceRequired": true,
    "generationBoundRecoveryEvidenceRequired": true,
    "backfillEvidenceRequiredWhenBackfillRequired": true,
    "mixedVersionObservationEvidenceRequired": true,
    "independentSecurityAndOperabilityReviewRequired": true,
    "unresolvedCriticalOrHighFindingsForbidden": true,
    "productionEvidenceMustRemainFalse": true,
    "applicationProductionReadyMustRemainFalse": true
  },
  "promotionRules": {
    "localMigrationEvidenceCanPromote": false,
    "candidateCompatibilityEvidenceAloneCanPromote": false,
    "unapprovedReleaseIdsCanPromote": false,
    "environmentIdWithoutGenerationCanPromote": false,
    "localRestoreArtifactCanPromoteGenerationBoundRecovery": false,
    "lockBudgetPassAloneCanPromote": false,
    "productionEquivalentAdmissionCanPromoteProduction": false,
    "automaticProductionReadyForbidden": true
  },
  "currentAuthority": {
    "admittedRehearsalCount": 0,
    "approvedReleasePairCount": 0,
    "registeredEnvironmentGenerationCount": 0,
    "productionShapedRehearsalCompleted": false,
    "mixedVersionCompatibilityProvenForApprovedPair": false,
    "generationBoundRecoveryLinked": false,
    "independentReviewCompleted": false,
    "productionEvidence": false,
    "productionReady": false,
    "productionDecision": "NO_GO"
  },
  "readiness": {
    "contractDefined": true,
    "registryImplemented": false,
    "writerImplemented": false,
    "validatorImplemented": false,
    "automaticWorkflowImplemented": false,
    "admittedRehearsalCount": 0,
    "productionShapedRehearsalCompleted": false,
    "productionReady": false
  }
}
