{
  "contractId": "memory-os.operability.migration-evidence-registry.v1",
  "schemaVersion": "memory-os-migration-evidence-registry-contract.v1",
  "description": "Append-only privacy-safe operator evidence authority for non-production migration rehearsals. Recovery evidence is split into an opaque SHA-256 reference to the rehearsal's actual recovery artifact, a separately validated environment restore-capability authority, and a per-run result proving that exact artifact was restored and the migration safely reapplied. CI/local rehearsals can never become production migration evidence.",
  "migrationLifecycleContract": "contracts/operations/migration-lifecycle-contract.v1.json",
  "registryPath": "contracts/operations/migration-evidence-registry.v1.json",
  "appendLockPath": "contracts/operations/.migration-evidence-registry.lock",
  "writer": "scripts/register-memory-os-migration-rehearsal-evidence.py",
  "validator": "scripts/validate-memory-os-migration-evidence-registry.py",
  "reconcile": "scripts/reconcile-memory-os-migration-evidence-registry.py",
  "workflow": ".github/workflows/migration-evidence-registry.yml",
  "recoveryPointValidator": "scripts/memory_os_migration_recovery_point.py",
  "recoveryArtifactResultValidator": "scripts/validate-memory-os-local-migration-recovery-artifact.py",
  "recordSchemaVersion": "memory-os-migration-rehearsal-evidence.v1",
  "appendOnly": true,
  "allowedEnvironmentClasses": [
    "LOCAL_POSTGRES_REHEARSAL",
    "PRODUCTION_EQUIVALENT_REHEARSAL"
  ],
  "productionEnvironmentRegistrationImplemented": false,
  "requiredRecordFields": [
    "schemaVersion",
    "migrationRunId",
    "environmentClass",
    "environmentGenerationId",
    "databaseIdentityDigest",
    "sourceCommitSha",
    "migrationSequenceBefore",
    "migrationSequenceAfter",
    "startedAt",
    "completedAt",
    "operatorRef",
    "reviewerRef",
    "recoveryPointReference",
    "recoveryPointArtifactDigest",
    "recoveryPointVerified",
    "restoreCapabilityEvidenceRef",
    "restoreCapabilityVerified",
    "recoveryPointRestoreEvidenceRef",
    "lockBudgetMs",
    "statementBudgetMs",
    "observedLockWaitMs",
    "observedRuntimeMs",
    "preflightResult",
    "applyResult",
    "verificationResult",
    "recoveryDecision",
    "openRisks",
    "containsSecrets",
    "productionTraffic",
    "productionCredentials",
    "productionEvidence"
  ],
  "registrationRules": {
    "inputRecordOutsideRepository": true,
    "cleanWorkingTreeRequired": true,
    "exactSourceCommitMustExist": true,
    "sourceCommitMustBeAncestorOfCurrentHead": true,
    "databaseIdentityStoredOnlyAsSha256": true,
    "operatorAndReviewerMustBeDistinctPseudonyms": true,
    "recoveryPointReferenceMustBeSha256Digest": true,
    "recoveryPointArtifactDigestMustMatchReference": true,
    "recoveryPointVerifiedRequired": true,
    "restoreCapabilityEvidenceMustExistAndPass": true,
    "restoreCapabilityVerifiedRequired": true,
    "actualRecoveryArtifactRestoreEvidenceRequired": true,
    "actualRecoveryArtifactDigestMustMatchRecord": true,
    "actualRecoveryArtifactRestoreResultMustPass": true,
    "productionEquivalentRehearsalRequiresConfiguredRestoreCapability": true,
    "lockAndStatementBudgetsRequired": true,
    "observedLockWaitMustNotExceedBudgetForPass": true,
    "observedRuntimeMustNotExceedStatementBudgetForPass": true,
    "migrationSequenceMustMatchCanonicalRegistry": true,
    "appendOnlyUniqueRunId": true,
    "productionTrafficForbidden": true,
    "productionCredentialsForbidden": true,
    "productionEvidenceForbidden": true,
    "atomicRegistryReplacement": true,
    "appendMustRevalidateCanonicalRegistryAndRollbackOnFailure": true
  },
  "restoreCapabilityAuthorities": {
    "LOCAL_POSTGRES_REHEARSAL": {
      "configured": true,
      "evidenceRef": "docs/fixtures/memory-os-operability/local-logical-restore-results.sample.v1.json",
      "schemaVersion": "memory-os-local-logical-restore-results.v1",
      "productionEvidenceRequired": false,
      "scope": "RESTORE_CAPABILITY_PROOF_ONLY_NOT_THE_REHEARSAL_RECOVERY_ARTIFACT"
    },
    "PRODUCTION_EQUIVALENT_REHEARSAL": {
      "configured": false,
      "evidenceRef": null,
      "schemaVersion": null,
      "productionEvidenceRequired": false,
      "scope": "BLOCKED_UNTIL_ENVIRONMENT_SPECIFIC_ISOLATED_RESTORE_CAPABILITY_IS_PROVEN"
    }
  },
  "actualRecoveryArtifactAuthorities": {
    "LOCAL_POSTGRES_REHEARSAL": {
      "evidenceRoot": "docs/evidence/migrations/recovery",
      "schemaVersion": "memory-os-local-migration-recovery-artifact.v1",
      "validator": "scripts/validate-memory-os-local-migration-recovery-artifact.py",
      "requireMigrationRunIdMatch": true,
      "requireArtifactDigestMatch": true,
      "requireActualRecoveryArtifactRestored": true,
      "productionEvidenceRequired": false
    },
    "PRODUCTION_EQUIVALENT_REHEARSAL": {
      "evidenceRoot": null,
      "schemaVersion": null,
      "validator": null,
      "requireMigrationRunIdMatch": true,
      "requireArtifactDigestMatch": true,
      "requireActualRecoveryArtifactRestored": true,
      "productionEvidenceRequired": false
    }
  },
  "resultValues": [
    "PASS",
    "FAIL",
    "NOT_RUN"
  ],
  "recoveryDecisions": [
    "NO_RECOVERY_REQUIRED",
    "STOP_AND_CORRECT",
    "VERIFY_DATABASE_ROLLBACK_THEN_CORRECT",
    "ROLL_BACK_APPLICATION_IF_SCHEMA_COMPATIBLE_OR_FORWARD_FIX",
    "PAUSE_BACKFILL_PRESERVE_STATE_AND_FORWARD_FIX",
    "INCIDENT_COMMAND_DECIDES_FORWARD_FIX_OR_ISOLATED_RESTORE"
  ],
  "forbiddenRecordContent": [
    "database URL or hostname",
    "database name in clear text",
    "credentials or tokens",
    "account, session, job, preview or object identifiers",
    "raw SQL output containing user data",
    "arbitrary repository file used as recovery proof",
    "generic restore capability proof presented as the actual recovery artifact",
    "recovery artifact digest with no matching per-run restore result",
    "claim that local rehearsal is production evidence"
  ],
  "currentAuthority": {
    "rehearsalEvidenceCount": 22,
    "passingRehearsalCount": 22,
    "productionEquivalentRehearsalCount": 0,
    "productionMigrationEvidenceCount": 0,
    "productionEvidence": false,
    "productionReady": false,
    "productionDecision": "NO_GO"
  },
  "readiness": {
    "contractDefined": true,
    "registryImplemented": true,
    "writerImplemented": true,
    "validatorImplemented": true,
    "automaticWorkflowImplemented": true,
    "operatorEvidenceRecordImplemented": true,
    "typedRecoveryArtifactReferenceImplemented": true,
    "localRestoreCapabilityBound": true,
    "perRunRecoveryArtifactEvidenceRequired": true,
    "productionEquivalentRestoreCapabilityConfigured": false,
    "localActualRecoveryArtifactRestoreLinked": true,
    "productionEquivalentActualRecoveryArtifactRestoreLinked": false,
    "productionShapedRehearsalCompleted": false,
    "independentReviewCompleted": false,
    "productionReady": false
  }
}
