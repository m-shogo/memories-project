{
  "contractId": "memory-os.operability.migration-evidence-registry.v1",
  "schemaVersion": "memory-os-migration-evidence-registry-contract.v1",
  "description": "Append-only privacy-safe operator evidence authority for non-production migration rehearsals. It implements the migration lifecycle evidence-record shape without allowing CI or local rehearsals to become production migration evidence. Production migration evidence requires a separate externally authorized authority.",
  "migrationLifecycleContract": "contracts/operations/migration-lifecycle-contract.v1.json",
  "registryPath": "contracts/operations/migration-evidence-registry.v1.json",
  "writer": "scripts/register-memory-os-migration-rehearsal-evidence.py",
  "validator": "scripts/validate-memory-os-migration-evidence-registry.py",
  "reconcile": "scripts/reconcile-memory-os-migration-evidence-registry.py",
  "workflow": ".github/workflows/migration-evidence-registry.yml",
  "recordSchemaVersion": "memory-os-migration-rehearsal-evidence.v1",
  "appendOnly": true,
  "allowedEnvironmentClasses": [
    "LOCAL_POSTGRES_REHEARSAL",
    "PRODUCTION_EQUIVALENT_REHEARSAL"
  ],
  "productionEnvironmentRegistrationImplemented": false,
  "requiredRecordFields": [
    "schemaVersion",
    "migrationRunId",
    "environmentClass",
    "environmentGenerationId",
    "databaseIdentityDigest",
    "sourceCommitSha",
    "migrationSequenceBefore",
    "migrationSequenceAfter",
    "startedAt",
    "completedAt",
    "operatorRef",
    "reviewerRef",
    "recoveryPointReference",
    "recoveryPointVerified",
    "lockBudgetMs",
    "statementBudgetMs",
    "observedLockWaitMs",
    "observedRuntimeMs",
    "preflightResult",
    "applyResult",
    "verificationResult",
    "recoveryDecision",
    "openRisks",
    "containsSecrets",
    "productionTraffic",
    "productionCredentials",
    "productionEvidence"
  ],
  "registrationRules": {
    "inputRecordOutsideRepository": true,
    "cleanWorkingTreeRequired": true,
    "exactSourceCommitMustExist": true,
    "databaseIdentityStoredOnlyAsSha256": true,
    "operatorAndReviewerMustBeDistinctPseudonyms": true,
    "recoveryPointReferenceMustExist": true,
    "recoveryPointVerifiedRequired": true,
    "lockAndStatementBudgetsRequired": true,
    "observedLockWaitMustNotExceedBudgetForPass": true,
    "observedRuntimeMustNotExceedStatementBudgetForPass": true,
    "migrationSequenceMustMatchCanonicalRegistry": true,
    "appendOnlyUniqueRunId": true,
    "productionTrafficForbidden": true,
    "productionCredentialsForbidden": true,
    "productionEvidenceForbidden": true,
    "atomicRegistryReplacement": true
  },
  "resultValues": [
    "PASS",
    "FAIL",
    "NOT_RUN"
  ],
  "recoveryDecisions": [
    "NO_RECOVERY_REQUIRED",
    "STOP_AND_CORRECT",
    "VERIFY_DATABASE_ROLLBACK_THEN_CORRECT",
    "ROLL_BACK_APPLICATION_IF_SCHEMA_COMPATIBLE_OR_FORWARD_FIX",
    "PAUSE_BACKFILL_PRESERVE_STATE_AND_FORWARD_FIX",
    "INCIDENT_COMMAND_DECIDES_FORWARD_FIX_OR_ISOLATED_RESTORE"
  ],
  "forbiddenRecordContent": [
    "database URL or hostname",
    "database name in clear text",
    "credentials or tokens",
    "account, session, job, preview or object identifiers",
    "raw SQL output containing user data",
    "claim that local rehearsal is production evidence"
  ],
  "currentAuthority": {
    "rehearsalEvidenceCount": 0,
    "passingRehearsalCount": 0,
    "productionEquivalentRehearsalCount": 0,
    "productionMigrationEvidenceCount": 0,
    "productionEvidence": false,
    "productionReady": false,
    "productionDecision": "NO_GO"
  },
  "readiness": {
    "contractDefined": true,
    "registryImplemented": true,
    "writerImplemented": true,
    "validatorImplemented": true,
    "automaticWorkflowImplemented": true,
    "operatorEvidenceRecordImplemented": true,
    "productionShapedRehearsalCompleted": false,
    "independentReviewCompleted": false,
    "productionReady": false
  }
}
