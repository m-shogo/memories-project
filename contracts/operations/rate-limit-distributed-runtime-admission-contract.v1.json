{
  "contractId": "memory-os.operability.rate-limit-distributed-runtime-admission.v1",
  "schemaVersion": "memory-os-rate-limit-distributed-runtime-admission.v1",
  "description": "Fail-closed admission authority for a deployed distributed rate-limit runtime. Local in-process limiter proofs and operation evidence remain valid foundations but cannot be relabeled as shared-store, trusted-proxy, restart-continuity or production control-plane evidence.",
  "sourcePolicyContract": "contracts/operations/rate-limit-policy-contract.v1.json",
  "sourceOperationsContract": "contracts/operations/rate-limit-operations-contract.v1.json",
  "sourceOperationEvidenceContract": "contracts/operations/rate-limit-operation-evidence-contract.v1.json",
  "environmentGenerationContract": "contracts/operations/production-equivalent-environment-generation-contract.v1.json",
  "environmentGenerationRegistry": "contracts/operations/production-equivalent-environment-generation-registry.v1.json",
  "registryPath": "contracts/operations/rate-limit-distributed-runtime-admission-registry.v1.json",
  "appendLockPath": "contracts/operations/.rate-limit-distributed-runtime.lock",
  "writer": "scripts/register-memory-os-rate-limit-distributed-runtime.py",
  "validator": "scripts/validate-memory-os-rate-limit-distributed-runtime.py",
  "reconcile": "scripts/reconcile-memory-os-rate-limit-distributed-runtime.py",
  "workflow": ".github/workflows/rate-limit-distributed-runtime-admission.yml",
  "recordSchemaVersion": "memory-os-rate-limit-distributed-runtime-record.v1",
  "independentReviewSchemaVersion": "memory-os-rate-limit-runtime-independent-review.v1",
  "allowedEnvironmentClasses": [
    "PRODUCTION_EQUIVALENT",
    "PRODUCTION"
  ],
  "requiredRecordFields": [
    "schemaVersion",
    "runtimeId",
    "environmentClass",
    "sourceCommitSha",
    "environmentIdentityDigest",
    "environmentGenerationId",
    "sharedStoreIdentityDigest",
    "trustedProxyConfigurationDigest",
    "runtimeInstanceIdentityDigests",
    "policyContractSha256",
    "sharedStoreEvidenceRefs",
    "trustedProxyEvidenceRefs",
    "restartContinuityEvidenceRefs",
    "failureModeEvidenceRefs",
    "emergencyExpiryEvidenceRefs",
    "deliveryAndAlertEvidenceRefs",
    "securityReviewRef",
    "operabilityReviewRef",
    "evidenceDigests",
    "unresolvedFindings",
    "evidenceComplete",
    "productionEvidence",
    "productionReady"
  ],
  "requiredRuntimeAssertions": {
    "atLeastTwoDistinctRuntimeInstances": true,
    "sourceCommitMustBeCurrentHeadAncestor": true,
    "sharedStoreProvidesAtomicCrossInstanceLimitAccounting": true,
    "sharedStoreStateHasBoundedExpiry": true,
    "unknownOrUnavailableSharedStateFailsClosedForProtectedRoutes": true,
    "trustedProxyAssignmentIsExplicitAndEnvironmentBound": true,
    "untrustedForwardingHeadersCannotCreateNewIdentityBuckets": true,
    "restartDoesNotResetSharedRateLimitState": true,
    "rollingRestartPreservesPolicyContinuity": true,
    "localEmergencyFallbackIsOnlyUsedWherePolicyAllowsIt": true,
    "emergencyModeHasRuntimeObservedAutomaticExpiry": true,
    "normalModeRestorationIsRuntimeVerified": true,
    "limiterBackendFailureAndExpiryFailuresAreAlerted": true,
    "operatorEvidenceUsesCanonicalPerOperationLedger": true,
    "productionCredentialsAndRawEndpointsAreForbiddenFromEvidence": true,
    "independentSecurityAndOperabilityReviewRequired": true,
    "independentReviewsMustBeTypedRuntimeBoundApprovedAndDistinct": true,
    "independentReviewRefsMustUseMonitoredNamespace": true,
    "evidenceRefsMustBeCommittedSymlinkFreeAndDigestBound": true,
    "appendLockMustRemainCanonical": true,
    "appendMustRevalidateCanonicalRegistryAndRollbackOnFailure": true,
    "unresolvedCriticalOrHighFindingsForbidden": true
  },
  "requiredDrillClasses": [
    "CROSS_INSTANCE_SHARED_BUDGET",
    "RUNTIME_RESTART_CONTINUITY",
    "SHARED_STORE_UNAVAILABLE_FAIL_CLOSED",
    "TRUSTED_PROXY_MISCONFIGURATION_FAIL_CLOSED",
    "EMERGENCY_MODE_AUTOMATIC_EXPIRY",
    "NORMAL_MODE_RESTORATION"
  ],
  "promotionRules": {
    "singleProcessLimiterCanPromoteDistributedRuntime": false,
    "ciOnlySharedStoreMockCanPromote": false,
    "proxyConfigFileWithoutDeploymentEvidenceCanPromote": false,
    "operationLedgerWithoutRuntimeMutationCanPromoteExpiry": false,
    "restartTestWithoutSharedStoreCanPromoteContinuity": false,
    "productionEquivalentRecordCanPromoteProduction": false,
    "singleDrillCanMakeRuntimeAdmitted": false,
    "automaticProductionReadyForbidden": true
  },
  "currentAuthority": {
    "admittedRuntimeCount": 0,
    "productionEquivalentRuntimeCount": 0,
    "productionRuntimeCount": 0,
    "distributedSharedStoreProven": false,
    "trustedProxyDeploymentProven": false,
    "restartContinuityProven": false,
    "runtimeAutomaticExpiryProven": false,
    "completedRequiredDrillClassCount": 0,
    "independentReviewCompleted": false,
    "productionEvidence": false,
    "productionReady": false,
    "productionDecision": "NO_GO"
  },
  "readiness": {
    "contractDefined": true,
    "registryImplemented": true,
    "writerImplemented": true,
    "validatorImplemented": true,
    "automaticWorkflowImplemented": true,
    "admittedRuntimeCount": 0,
    "productionEquivalentRuntimeAvailable": false,
    "productionRuntimeAvailable": false,
    "productionReady": false
  }
}
