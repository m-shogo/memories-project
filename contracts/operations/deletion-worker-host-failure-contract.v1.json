{
  "contractId": "memory-os.operability.deletion-worker-host-failure.v1",
  "schemaVersion": "memory-os-deletion-worker-host-failure.v1",
  "description": "Fail-closed admission authority for deletion-worker recovery after physical host, VM or worker-node loss. Existing process SIGKILL and Docker container-kill evidence are explicitly insufficient substitutes.",
  "failureClass": "PHYSICAL_HOST_OR_VM_NODE_LOSS",
  "dependencyMode": "PRODUCTION_EQUIVALENT_REQUIRED",
  "environmentGenerationContract": "contracts/operations/production-equivalent-environment-generation-contract.v1.json",
  "environmentGenerationRegistry": "contracts/operations/production-equivalent-environment-generation-registry.v1.json",
  "validator": "scripts/validate-memory-os-deletion-worker-host-failure.py",
  "reconcile": "scripts/reconcile-memory-os-deletion-worker-host-failure.py",
  "workflow": ".github/workflows/deletion-worker-host-failure-admission.yml",
  "requiredPrerequisites": {
    "registeredProductionEquivalentEnvironmentGeneration": true,
    "validatedEnvironmentManifest": true,
    "syntheticAccountsOnly": true,
    "productionTrafficForbidden": true,
    "productionCredentialsForbidden": true,
    "failureControllerOutsideTargetNode": true,
    "atLeastTwoDistinctWorkerNodeIdentities": true,
    "sharedPostgreSQLAndObjectStoreRemainReachableToReplacementNode": true,
    "sameEnvironmentGenerationForKilledAndReplacementWorkers": true,
    "appendOnlyResultEvidence": true,
    "independentReview": true
  },
  "requiredAssertions": {
    "targetNodeLossObservedOutsideTargetNode": true,
    "killedWorkerCannotExecuteCleanupOrRelease": true,
    "canonicalDeletionLedgerSurvivesNodeLoss": true,
    "noCompetingClaimBeforeLeaseExpiry": true,
    "replacementWorkerRunsOnDifferentNode": true,
    "replacementReceiptAttemptEquals2": true,
    "objectErasureIsIdempotentAcrossNodeLoss": true,
    "databaseSweepAndTombstoneConverge": true,
    "deletionBacklogConvergesToZero": true,
    "ownedRowsConvergeToZero": true,
    "objectVersionsConvergeToZero": true,
    "noResurrection": true
  },
  "requiredEvidenceBindings": [
    "environment generation id and manifest SHA-256",
    "target worker node identity digest",
    "replacement worker node identity digest distinct from target",
    "external failure-controller identity digest",
    "failure request and observed node-loss timestamps",
    "lease expiry timestamp and first replacement claim timestamp",
    "replacement receipt attempt count",
    "PostgreSQL reconnect result",
    "object-store reconnect and exact-version erasure result",
    "final deletion backlog, owned-row and object-version counts",
    "independent review record"
  ],
  "forbiddenEvidenceSubstitutions": [
    "process SIGKILL inside a surviving host",
    "Docker container kill while the host remains healthy",
    "replacement worker launched on the same node",
    "local PostgreSQL fixture",
    "local MinIO fixture",
    "CI PASS without a registered production-equivalent environment generation",
    "host failure asserted only from missing application heartbeat",
    "production traffic or production credentials used as a shortcut"
  ],
  "promotionRules": {
    "processKillCanPromoteHostFailure": false,
    "containerKillCanPromoteHostFailure": false,
    "sameNodeRestartCanPromoteHostFailure": false,
    "singleNodeEnvironmentCanPromoteHostFailure": false,
    "automaticProductionPromotionForbidden": true,
    "automaticThresholdApprovalForbidden": true,
    "availabilityZoneFailureRequiresSeparateEvidence": true
  },
  "currentBoundary": {
    "environmentGenerationAvailable": false,
    "actualPhysicalHostOrVMNodeLossCovered": false,
    "externalFailureControllerCovered": false,
    "replacementDifferentNodeCovered": false,
    "leaseExclusionUntilExpiryCovered": false,
    "replacementAttempt2Covered": false,
    "dependencyReconnectCovered": false,
    "zeroOwnedRowsAfterRecoveryCovered": false,
    "zeroObjectVersionsAfterRecoveryCovered": false,
    "independentReviewCompleted": false,
    "deletionHostFailureRecoveryProven": false,
    "productionEquivalentEvidence": false,
    "productionEvidence": false,
    "productionReady": false,
    "productionDecision": "NO_GO"
  },
  "readiness": {
    "contractDefined": true,
    "validatorImplemented": true,
    "automaticWorkflowImplemented": true,
    "environmentGenerationAvailable": false,
    "hostFailureDrillExecuted": false,
    "hostFailureResultCommitted": false,
    "independentReviewCompleted": false,
    "deletionHostFailureRecoveryProven": false,
    "productionEquivalentEvidence": false,
    "productionReady": false
  },
  "limitations": [
    "no production-equivalent environment generation is registered",
    "no physical host, VM or worker-node termination has been executed",
    "availability-zone loss is a separate stronger failure class and remains unproven",
    "this admission contract creates no production or production-equivalent evidence"
  ]
}
