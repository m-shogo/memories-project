{
  "contractId": "memory-os.operability.backup-restore-drill-preflight.v1",
  "schemaVersion": "memory-os-backup-restore-drill-preflight-contract.v1",
  "description": "Deterministic read-only preflight authority for deciding whether the repository has enough reviewed production-equivalent environment generations and an explicitly approved current recovery objective to submit a backup/restore drill request for human review. READY never creates a request, never runs a backup or restore, never changes traffic, and never establishes production evidence or production readiness.",
  "environmentGenerationContract": "contracts/operations/production-equivalent-environment-generation-contract.v1.json",
  "environmentGenerationRegistry": "contracts/operations/production-equivalent-environment-generation-registry.v1.json",
  "recoveryObjectivesRegistry": "contracts/operations/recovery-objectives-registry.v1.json",
  "drillRequestContract": "contracts/operations/backup-restore-drill-request-contract.v1.json",
  "drillRequestRegistry": "contracts/operations/backup-restore-drill-request-registry.v1.json",
  "admissionChainContract": "contracts/operations/backup-restore-admission-chain-contract.v1.json",
  "validator": "scripts/validate-memory-os-backup-restore-drill-preflight.py",
  "reconcile": "scripts/reconcile-memory-os-backup-restore-drill-preflight.py",
  "workflow": ".github/workflows/backup-restore-drill-preflight.yml",
  "preflightRules": {
    "atLeastTwoUnsupersededGenerationsRequired": true,
    "sourceAndTargetEnvironmentIdsMustDiffer": true,
    "sourceAndTargetGenerationIdsMustDiffer": true,
    "currentApprovedRecoveryObjectiveRequired": true,
    "eligiblePairMustUseRegisteredImmutableGenerations": true,
    "reviewedRequestStillRequiredAfterReady": true,
    "requestMustStillPassExecutionTimeRevalidation": true,
    "productionTrafficForbidden": true,
    "productionCredentialsForbidden": true,
    "automaticRequestCreationForbidden": true,
    "automaticDrillExecutionForbidden": true,
    "automaticPromotionForbidden": true,
    "productionEvidenceForbidden": true,
    "productionReadyForbidden": true
  },
  "decisionStates": [
    "BLOCKED_NEEDS_TWO_UNSUPERSEDED_DISTINCT_ENVIRONMENT_GENERATIONS",
    "BLOCKED_NEEDS_CURRENT_APPROVED_RECOVERY_OBJECTIVE",
    "READY_FOR_REVIEWED_DRILL_REQUEST_SUBMISSION",
    "READY_EXISTING_EXECUTABLE_DRILL_REQUEST"
  ],
  "currentState": {
    "registeredGenerationCount": 0,
    "unsupersededGenerationCount": 0,
    "distinctUnsupersededEnvironmentCount": 0,
    "eligibleDirectedSourceTargetPairCount": 0,
    "approvedRecoveryObjectiveCount": 0,
    "currentObjectiveId": null,
    "reviewedDrillRequestCount": 0,
    "currentExecutableDrillRequestCount": 0,
    "eligibleToSubmitReviewedDrillRequest": false,
    "preflightDecision": "BLOCKED_NEEDS_TWO_UNSUPERSEDED_DISTINCT_ENVIRONMENT_GENERATIONS",
    "requestCreated": false,
    "backupExecuted": false,
    "restoreExecuted": false,
    "productionTrafficChanged": false,
    "productionEvidence": false,
    "productionReady": false,
    "productionDecision": "NO_GO"
  },
  "readiness": {
    "contractDefined": true,
    "validatorImplemented": true,
    "reconcileImplemented": true,
    "automaticWorkflowImplemented": true,
    "twoDistinctUnsupersededEnvironmentGenerationsAvailable": false,
    "currentRecoveryObjectiveAvailable": false,
    "eligibleSourceTargetPairAvailable": false,
    "reviewedDrillRequestSubmissionEligible": false,
    "currentExecutableDrillRequestAvailable": false,
    "drillExecuted": false,
    "productionReady": false
  },
  "limitations": [
    "preflight is read-only admission guidance and never provisions an environment",
    "preflight never invents RPO, RTO or object/database skew targets",
    "preflight READY still requires an external reviewed drill request submitted through the fail-closed request writer",
    "a reviewed drill request is planning authority only and still requires immediate revalidation before any execution",
    "production promotion remains a separate human decision after complete recovery evidence"
  ]
}
