{
  "contractId": "memory-os.operability.backup-restore-promotion-review.v1",
  "schemaVersion": "memory-os-backup-restore-promotion-review-contract.v1",
  "recordSchemaVersion": "memory-os-backup-restore-promotion-review-record.v2",
  "reviewEvidenceSchemaVersion": "memory-os-backup-restore-promotion-review-evidence.v1",
  "reviewEvidenceRoot": "docs/evidence/backup-restore",
  "description": "Append-only human review authority after a final production-equivalent recovery candidate exists. Historical review rows remain auditable after legitimate upstream supersession, while current promotion authority is revoked fail-closed. Every review row binds one rationale payload and three distinct typed human review payloads (Recovery Owner, Security and Operability) by immutable SHA-256 digests. Human review evidence must bind the exact decisionId and final recovery candidate, remain inside the monitored backup/restore evidence namespace and remain non-automatic. A review may recommend GO, NO_GO or DEFER, but this authority never changes traffic, never writes production credentials, never creates production evidence, and never makes the application production-ready. Application production promotion remains governed separately.",
  "registry": "contracts/operations/backup-restore-promotion-review-registry.v1.json",
  "generationEvidenceRegistry": "contracts/operations/backup-restore-generation-evidence-registry.v1.json",
  "typedNonResurrectionRegistry": "contracts/operations/backup-restore-non-resurrection-admission-registry.v1.json",
  "writer": "scripts/register-memory-os-backup-restore-promotion-review.py",
  "validator": "scripts/validate-memory-os-backup-restore-promotion-review.py",
  "negativeAdmissionValidator": "scripts/validate-memory-os-backup-restore-promotion-review-negative.py",
  "workflow": ".github/workflows/backup-restore-promotion-review.yml",
  "requiredRecordFields": [
    "schemaVersion",
    "decisionId",
    "recoveryEvidenceId",
    "decidedAt",
    "decision",
    "rationaleRef",
    "rationaleSha256",
    "recoveryOwnerReviewRef",
    "recoveryOwnerReviewSha256",
    "securityReviewRef",
    "securityReviewSha256",
    "operabilityReviewRef",
    "operabilityReviewSha256",
    "unresolvedFindings",
    "productionTrafficChanged",
    "productionCredentialsUsed",
    "productionEvidence",
    "productionReady"
  ],
  "requiredReviewEvidenceFields": [
    "schemaVersion",
    "decisionId",
    "recoveryEvidenceId",
    "reviewRole",
    "reviewResult",
    "reviewedAt",
    "reviewerPseudonym",
    "productionTrafficChanged",
    "productionCredentialsUsed",
    "automaticPromotion"
  ],
  "reviewRoles": {
    "recoveryOwnerReviewRef": "RECOVERY_OWNER",
    "securityReviewRef": "SECURITY",
    "operabilityReviewRef": "OPERABILITY"
  },
  "rules": {
    "finalRecoveryCandidateRequired": true,
    "currentCandidatePredicateMustBeRevalidated": true,
    "promotionEvidenceMustRemainInsideMonitoredNamespace": true,
    "threeDistinctHumanReviewRefsRequired": true,
    "threeDistinctHumanReviewerPseudonymsRequired": true,
    "typedHumanReviewEvidenceRequired": true,
    "humanReviewMustBindDecisionId": true,
    "humanReviewMustBindRecoveryEvidenceId": true,
    "humanReviewRoleMustMatchReference": true,
    "humanReviewMustBeApproved": true,
    "humanReviewMustNotPostdateDecision": true,
    "humanReviewPayloadSha256BindingRequired": true,
    "rationaleEvidenceRequired": true,
    "rationalePayloadSha256BindingRequired": true,
    "goRecommendationRequiresZeroUnresolvedFindings": true,
    "reviewDoesNotAuthorizeTrafficChange": true,
    "reviewDoesNotAuthorizeProductionCredentials": true,
    "reviewDoesNotCreateProductionEvidence": true,
    "reviewDoesNotCreateProductionReady": true,
    "appendOnlyDecisionHistoryRequired": true,
    "appendMustRevalidateCanonicalRegistryAndRollbackOnFailure": true,
    "historicalReviewRemainsAuditableAfterCandidateSupersession": true,
    "currentPromotionAuthorityRevokedWhenCandidateStopsBeingCurrent": true,
    "currentPromotionAuthorityCannotBeAutoCreatedOrReactivated": true,
    "mutableLatestAliasForbidden": true
  },
  "decisionValues": [
    "GO_RECOMMENDATION",
    "NO_GO",
    "DEFER"
  ],
  "currentBoundary": {
    "registeredReviewCount": 0,
    "goRecommendationCount": 0,
    "noGoCount": 0,
    "deferCount": 0,
    "latestDecisionId": null,
    "currentDecisionId": null,
    "productionTrafficChanged": false,
    "productionEvidence": false,
    "productionReady": false,
    "productionDecision": "NO_GO"
  }
}
