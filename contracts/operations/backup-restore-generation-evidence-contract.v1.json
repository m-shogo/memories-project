  "recordRules": {
    "drillRequestMustExist": true,
    "drillRequestMustBeCurrentlyExecutableForNewEvidence": true,
    "historicalEvidenceMayRemainAuditableAfterDrillRequestBecomesStale": true,
    "drillRequestSourceGenerationMustMatchEvidence": true,
    "drillRequestRestoreTargetGenerationMustMatchEvidence": true,
    "drillRequestRecoveryObjectivesIdMustMatchEvidence": true,
    "sourceAndTargetGenerationMustExist": true,
    "generationManifestDigestsMustMatchRegistry": true,
    "recoveryObjectivesRegistryMustRemainAppendOnly": true,
    "recoveryObjectivesRegistryAggregateCountMustMatchRows": true,
    "recoveryObjectivesRegistryCurrentPointerMustMatchLatestApprovedRow": true,
    "recoveryObjectivesRegistryProductionBoundaryMustRemainFalse": true,
    "restoreMustReferenceExactBackupArtifact": true,
    "backupAndRestoreEvidenceDigestsRequired": true,
    "crossGenerationRestoreRequiresMaterialDeltaReview": true,
    "sameGenerationRestoreMayUseNullMaterialDeltaReview": true,
    "crossGenerationMaterialDeltaReviewMustRemainInsideMonitoredNamespace": true,
    "crossGenerationMaterialDeltaReviewMustRemainAppendOnlyAfterFirstCommit": true,
    "crossGenerationMaterialDeltaReviewMustBeTyped": true,
    "crossGenerationMaterialDeltaReviewMustBindEvidenceId": true,
    "crossGenerationMaterialDeltaReviewMustBindDrillRequestId": true,
    "crossGenerationMaterialDeltaReviewMustBindRecoveryObjectivesId": true,
