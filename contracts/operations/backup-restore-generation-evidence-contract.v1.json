  "materialDeltaReviewEvidenceSchemaVersion": "memory-os-backup-restore-material-delta-review.v1",
  "description": "Append-only admission contract for reviewed backup and isolated-restore evidence bound to a previously admitted production-equivalent restore drill request, registered production-equivalent environment generations and explicitly approved recovery objectives. A generation record may satisfy all pre-overlay recovery controls without becoming a production-equivalent recovery candidate; final candidate derivation additionally requires complete typed non-resurrection coverage, typed append-only independent Security and Operability reviews by distinct reviewer pseudonyms, and typed append-only material-delta review authority for cross-generation restores. Historical admitted evidence remains auditable after its drill request or authority is superseded, but new evidence registration requires a currently executable drill request. The registry can never by itself establish production evidence or application production readiness.",
  "registry": "contracts/operations/backup-restore-generation-evidence-registry.v1.json",
  "environmentGenerationRegistry": "contracts/operations/production-equivalent-environment-generation-registry.v1.json",
  "recoveryObjectivesRegistry": "contracts/operations/recovery-objectives-registry.v1.json",
