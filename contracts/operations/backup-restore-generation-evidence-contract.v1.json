{
  "contractId": "memory-os.operability.backup-restore-generation-evidence.v1",
  "schemaVersion": "memory-os-backup-restore-generation-evidence.v1",
  "recordSchemaVersion": "memory-os-backup-restore-generation-evidence-record.v1",
  "description": "Append-only admission contract for reviewed backup and isolated-restore evidence bound to registered production-equivalent environment generations. The registry can establish a production-equivalent recovery candidate but can never by itself establish production evidence or application production readiness.",
  "registry": "contracts/operations/backup-restore-generation-evidence-registry.v1.json",
  "environmentGenerationRegistry": "contracts/operations/production-equivalent-environment-generation-registry.v1.json",
  "generationBindingContract": "contracts/operations/backup-restore-generation-binding-contract.v1.json",
  "writer": "scripts/register-memory-os-backup-restore-generation-evidence.py",
  "validator": "scripts/validate-memory-os-backup-restore-generation-evidence.py",
  "reconcile": "scripts/reconcile-memory-os-backup-restore-generation-evidence.py",
  "workflow": ".github/workflows/backup-restore-generation-evidence.yml",
  "requiredRecordFields": [
    "schemaVersion",
    "evidenceId",
    "sourceCommitSha",
    "sourceEnvironmentGenerationId",
    "sourceEnvironmentManifestSha256",
    "restoreTargetGenerationId",
    "restoreTargetManifestSha256",
    "backupArtifactSha256",
    "backupManifestSha256",
    "databaseRecoveryPointDigest",
    "objectRecoveryPointDigest",
    "restoreEvidenceBundleSha256",
    "restoredBackupArtifactSha256",
    "isolatedRestoreVerified",
    "postgresPitrVerified",
    "independentObjectRetentionVerified",
    "tlsVerified",
    "restoreOnlyCredentialSeparationVerified",
    "databaseObjectRecoveryCoherenceVerified",
    "nonResurrectionVerification",
    "approvedRecoveryObjectivesRef",
    "measuredRpoSeconds",
    "measuredRtoSeconds",
    "materialDeltaReviewRef",
    "securityReviewRef",
    "operabilityReviewRef",
    "unresolvedFindings",
    "evidenceComplete",
    "productionTraffic",
    "productionCredentials",
    "productionEvidence",
    "productionReady"
  ],
  "recordRules": {
    "sourceAndTargetGenerationMustExist": true,
    "generationManifestDigestsMustMatchRegistry": true,
    "restoreMustReferenceExactBackupArtifact": true,
    "backupAndRestoreEvidenceDigestsRequired": true,
    "crossGenerationRestoreRequiresMaterialDeltaReview": true,
    "sameGenerationRestoreMayUseNullMaterialDeltaReview": true,
    "isolatedRestoreRequired": true,
    "postgresPitrRequiredForProductionEquivalentRestoreCandidate": true,
    "independentObjectRetentionRequiredForProductionEquivalentRestoreCandidate": true,
    "tlsRequiredForProductionEquivalentRestoreCandidate": true,
    "restoreOnlyCredentialSeparationRequiredForProductionEquivalentRestoreCandidate": true,
    "databaseObjectRecoveryCoherenceRequiredForProductionEquivalentRestoreCandidate": true,
    "nonResurrectionVerificationRequiredForProductionEquivalentRestoreCandidate": true,
    "approvedRecoveryObjectivesRequiredBeforeRpoRtoCanSatisfyAdmission": true,
    "independentSecurityAndOperabilityReviewsRequired": true,
    "criticalOrHighOpenFindingsForbidden": true,
    "productionTrafficForbidden": true,
    "productionCredentialsForbidden": true,
    "productionEvidenceForbidden": true,
    "productionReadyForbidden": true,
    "legacyLocalEvidenceRelabelForbidden": true,
    "mutableLatestAliasForbidden": true,
    "rawUrlsSecretsTokensAccountAndSessionIdentifiersForbidden": true
  },
  "promotionBoundary": {
    "productionEquivalentRecoveryCandidateMayBeDerivedFromCompleteReviewedRecord": true,
    "productionEvidenceMayBeDerived": false,
    "productionReadyMayBeDerived": false,
    "humanProductionPromotionDecisionRequiredSeparately": true
  },
  "currentBoundary": {
    "registeredEvidenceCount": 0,
    "completeGenerationBoundBackupCount": 0,
    "completeGenerationBoundRestoreCount": 0,
    "productionEquivalentRecoveryCandidateCount": 0,
    "productionEquivalentRestoreEvidence": false,
    "productionEvidence": false,
    "productionReady": false,
    "productionDecision": "NO_GO"
  },
  "readiness": {
    "contractDefined": true,
    "registryDefined": true,
    "writerImplemented": true,
    "validatorImplemented": true,
    "reconcileImplemented": true,
    "automaticWorkflowImplemented": true,
    "environmentGenerationAvailable": false,
    "generationBoundBackupAvailable": false,
    "generationBoundRestoreAvailable": false,
    "productionEquivalentRecoveryCandidateAvailable": false,
    "independentReviewCompleted": false,
    "productionEquivalentRestoreEvidence": false,
    "productionReady": false
  }
}
