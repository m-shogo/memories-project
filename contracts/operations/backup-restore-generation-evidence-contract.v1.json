{
  "contractId": "memory-os.operability.backup-restore-generation-evidence.v1",
  "schemaVersion": "memory-os-backup-restore-generation-evidence.v1",
  "recordSchemaVersion": "memory-os-backup-restore-generation-evidence-record.v1",
  "description": "Append-only admission contract for reviewed backup and isolated-restore evidence bound to a previously admitted production-equivalent restore drill request, registered production-equivalent environment generations and explicitly approved recovery objectives. A generation record may satisfy all pre-overlay recovery controls without becoming a production-equivalent recovery candidate; final candidate derivation additionally requires complete typed non-resurrection coverage. Historical admitted evidence remains auditable after its drill request or authority is superseded, but new evidence registration requires a currently executable drill request. The registry can never by itself establish production evidence or application production readiness.",
  "registry": "contracts/operations/backup-restore-generation-evidence-registry.v1.json",
  "environmentGenerationRegistry": "contracts/operations/production-equivalent-environment-generation-registry.v1.json",
  "recoveryObjectivesRegistry": "contracts/operations/recovery-objectives-registry.v1.json",
  "drillRequestContract": "contracts/operations/backup-restore-drill-request-contract.v1.json",
  "drillRequestRegistry": "contracts/operations/backup-restore-drill-request-registry.v1.json",
  "generationBindingContract": "contracts/operations/backup-restore-generation-binding-contract.v1.json",
  "typedNonResurrectionAdmissionContract": "contracts/operations/backup-restore-non-resurrection-admission-contract.v1.json",
  "typedNonResurrectionAdmissionRegistry": "contracts/operations/backup-restore-non-resurrection-admission-registry.v1.json",
  "writer": "scripts/register-memory-os-backup-restore-generation-evidence.py",
  "validator": "scripts/validate-memory-os-backup-restore-generation-evidence.py",
  "negativeAdmissionValidator": "scripts/validate-memory-os-backup-restore-generation-evidence-negative.py",
  "reconcile": "scripts/reconcile-memory-os-backup-restore-generation-evidence.py",
  "workflow": ".github/workflows/backup-restore-generation-evidence.yml",
  "requiredRecordFields": [
    "schemaVersion",
    "evidenceId",
    "drillRequestId",
    "sourceCommitSha",
    "sourceEnvironmentGenerationId",
    "sourceEnvironmentManifestSha256",
    "restoreTargetGenerationId",
    "restoreTargetManifestSha256",
    "backupArtifactSha256",
    "backupManifestSha256",
    "databaseRecoveryPointDigest",
    "objectRecoveryPointDigest",
    "restoreEvidenceBundleSha256",
    "restoredBackupArtifactSha256",
    "isolatedRestoreVerified",
    "postgresPitrVerified",
    "independentObjectRetentionVerified",
    "tlsVerified",
    "restoreOnlyCredentialSeparationVerified",
    "databaseObjectRecoveryCoherenceVerified",
    "nonResurrectionVerification",
    "recoveryObjectivesId",
    "measuredRpoSeconds",
    "measuredRtoSeconds",
    "measuredObjectDatabaseSkewSeconds",
    "materialDeltaReviewRef",
    "securityReviewRef",
    "operabilityReviewRef",
    "unresolvedFindings",
    "evidenceComplete",
    "productionTraffic",
    "productionCredentials",
    "productionEvidence",
    "productionReady"
  ],
  "recordRules": {
    "drillRequestMustExist": true,
    "drillRequestMustBeCurrentlyExecutableForNewEvidence": true,
    "historicalEvidenceMayRemainAuditableAfterDrillRequestBecomesStale": true,
    "drillRequestSourceGenerationMustMatchEvidence": true,
    "drillRequestRestoreTargetGenerationMustMatchEvidence": true,
    "drillRequestRecoveryObjectivesIdMustMatchEvidence": true,
    "sourceAndTargetGenerationMustExist": true,
    "generationManifestDigestsMustMatchRegistry": true,
    "restoreMustReferenceExactBackupArtifact": true,
    "backupAndRestoreEvidenceDigestsRequired": true,
    "crossGenerationRestoreRequiresMaterialDeltaReview": true,
    "sameGenerationRestoreMayUseNullMaterialDeltaReview": true,
    "isolatedRestoreRequired": true,
    "postgresPitrRequiredForProductionEquivalentRestoreCandidate": true,
    "independentObjectRetentionRequiredForProductionEquivalentRestoreCandidate": true,
    "tlsRequiredForProductionEquivalentRestoreCandidate": true,
    "restoreOnlyCredentialSeparationRequiredForProductionEquivalentRestoreCandidate": true,
    "databaseObjectRecoveryCoherenceRequiredForProductionEquivalentRestoreCandidate": true,
    "nonResurrectionVerificationRequiredForProductionEquivalentRestoreCandidate": true,
    "typedNonResurrectionCoverageRequiredForProductionEquivalentRestoreCandidate": true,
    "genericNonResurrectionPassAloneCannotCreateCandidate": true,
    "currentApprovedRecoveryObjectivesIdRequiredForCandidate": true,
    "measuredRpoMustMeetApprovedTarget": true,
    "measuredRtoMustMeetApprovedTarget": true,
    "measuredObjectDatabaseSkewMustMeetApprovedTarget": true,
    "restoreEvidenceCannotInventRecoveryObjectives": true,
    "independentSecurityAndOperabilityReviewsRequired": true,
    "criticalOrHighOpenFindingsForbidden": true,
    "productionTrafficForbidden": true,
    "productionCredentialsForbidden": true,
    "productionEvidenceForbidden": true,
    "productionReadyForbidden": true,
    "legacyLocalEvidenceRelabelForbidden": true,
    "mutableLatestAliasForbidden": true,
    "rawUrlsSecretsTokensAccountAndSessionIdentifiersForbidden": true
  },
  "negativeAdmissionCases": [
    "no registered production-equivalent generation",
    "unregistered drill request",
    "drill request source generation mismatch",
    "drill request restore target generation mismatch",
    "drill request recovery objective mismatch",
    "stale or superseded drill request for new evidence",
    "security and operability review reuse",
    "missing review evidence path",
    "cross-generation restore without material-delta review",
    "unregistered restore target generation",
    "generation manifest digest mismatch",
    "restored artifact differs from exact backup artifact",
    "historical approved recovery objective cannot become current candidate",
    "measured RPO exceeding approved target cannot become candidate",
    "generic non-resurrection PASS without typed domain coverage cannot become candidate",
    "HIGH or CRITICAL unresolved finding",
    "mutable latest alias",
    "production evidence relabel"
  ],
  "promotionBoundary": {
    "productionEquivalentRecoveryCandidateMayBeDerivedFromCompleteReviewedRecord": true,
    "completeReviewedRecordAlsoRequiresAdmittedDrillRequestBinding": true,
    "completeReviewedRecordAlsoRequiresTypedNonResurrectionCoverage": true,
    "productionEvidenceMayBeDerived": false,
    "productionReadyMayBeDerived": false,
    "humanProductionPromotionDecisionRequiredSeparately": true
  },
  "currentBoundary": {
    "registeredEvidenceCount": 0,
    "drillRequestBoundEvidenceCount": 0,
    "completeGenerationBoundBackupCount": 0,
    "completeGenerationBoundRestoreCount": 0,
    "productionEquivalentRecoveryCandidateCount": 0,
    "productionEquivalentRestoreEvidence": false,
    "productionEvidence": false,
    "productionReady": false,
    "productionDecision": "NO_GO"
  },
  "readiness": {
    "contractDefined": true,
    "registryDefined": true,
    "writerImplemented": true,
    "validatorImplemented": true,
    "negativeAdmissionSuiteImplemented": true,
    "reconcileImplemented": true,
    "automaticWorkflowImplemented": true,
    "environmentGenerationAvailable": false,
    "approvedRecoveryObjectivesAvailable": false,
    "drillRequestAvailable": false,
    "generationBoundBackupAvailable": false,
    "generationBoundRestoreAvailable": false,
    "productionEquivalentRecoveryCandidateAvailable": false,
    "independentReviewCompleted": false,
    "productionEquivalentRestoreEvidence": false,
    "productionReady": false
  }
}
