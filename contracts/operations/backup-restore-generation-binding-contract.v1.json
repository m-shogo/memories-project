{
  "contractId": "memory-os.operability.backup-restore-generation-binding.v1",
  "schemaVersion": "memory-os-backup-restore-generation-binding.v1",
  "description": "Fail-closed admission authority for promoting backup/restore evidence into a production-equivalent environment generation. Existing exact-source local PostgreSQL and object-version restore foundations remain local-only and cannot be relabeled. A production-equivalent recovery candidate is evidence eligibility only and never completes independent human promotion review.",
  "backupRestorePolicyContract": "contracts/operations/backup-restore-contract.v1.json",
  "localFoundationEvidence": "contracts/operations/backup-local-foundation-evidence.v1.json",
  "environmentGenerationContract": "contracts/operations/production-equivalent-environment-generation-contract.v1.json",
  "environmentGenerationRegistry": "contracts/operations/production-equivalent-environment-generation-registry.v1.json",
  "generationEvidenceContract": "contracts/operations/backup-restore-generation-evidence-contract.v1.json",
  "generationEvidenceRegistry": "contracts/operations/backup-restore-generation-evidence-registry.v1.json",
  "validator": "scripts/validate-memory-os-backup-restore-generation-binding.py",
  "workflow": ".github/workflows/backup-restore-generation-binding.yml",
  "requiredBindings": {
    "backupArtifactSha256Required": true,
    "backupManifestSha256Required": true,
    "sourceEnvironmentGenerationIdRequired": true,
    "sourceEnvironmentManifestSha256Required": true,
    "sourceCommitShaRequired": true,
    "restoreTargetGenerationIdRequired": true,
    "restoreTargetManifestSha256Required": true,
    "restoreEvidenceBundleSha256Required": true,
    "restoreResultMustReferenceBackupArtifactSha256": true,
    "sourceGenerationMustExistInAppendOnlyRegistry": true,
    "restoreTargetGenerationMustExistInAppendOnlyRegistry": true,
    "sourceManifestMustMatchRegisteredGeneration": true,
    "restoreTargetManifestMustMatchRegisteredGeneration": true,
    "crossGenerationRestoreRequiresMaterialDeltaReview": true,
    "unknownOrSupersededCurrentGenerationFailsClosed": true
  },
  "promotionRules": {
    "legacyLocalRestoreCanBeRelabeled": false,
    "backupTimestampAloneIsSufficient": false,
    "environmentIdWithoutGenerationIsSufficient": false,
    "sameDatabaseEngineVersionAloneIsSufficient": false,
    "sameObjectStoreVendorAloneIsSufficient": false,
    "hashOnlyWithoutRegisteredGenerationIsSufficient": false,
    "restoreIntoProductionRequired": false,
    "productionCredentialsRequired": false,
    "isolatedRestoreRequired": true,
    "independentReviewRequired": true,
    "recoveryCandidateAutomaticallyCompletesIndependentReview": false,
    "recoveryCandidateAutomaticallyAuthorizesProductionPromotion": false,
    "humanProductionPromotionReviewRemainsSeparate": true
  },
  "currentBoundary": {
    "registeredProductionEquivalentGenerationCount": 0,
    "generationBoundBackupCount": 0,
    "generationBoundRestoreCount": 0,
    "productionEquivalentRecoveryCandidateCount": 0,
    "productionEquivalentRestoreEvidence": false,
    "independentReviewCompleted": false,
    "humanProductionPromotionAuthorized": false,
    "productionEvidence": false,
    "productionReady": false,
    "productionDecision": "NO_GO"
  },
  "readiness": {
    "contractDefined": true,
    "validatorImplemented": true,
    "automaticWorkflowImplemented": true,
    "generationEvidenceRegistryImplemented": true,
    "localPostgresqlRestoreFoundationAvailable": true,
    "localObjectVersionRestoreFoundationAvailable": true,
    "environmentGenerationAvailable": false,
    "generationBoundBackupAvailable": false,
    "generationBoundRestoreAvailable": false,
    "productionEquivalentRecoveryCandidateAvailable": false,
    "independentReviewCompleted": false,
    "humanProductionPromotionAuthorized": false,
    "productionEquivalentRestoreEvidence": false,
    "productionReady": false
  },
  "limitations": [
    "the existing exact-source local PostgreSQL and MinIO restore proofs remain local-only",
    "no production-equivalent environment generation or generation-bound recovery evidence is currently registered",
    "recovery objectives and reviewed restore drill requests remain separately governed and cannot be invented by restore evidence",
    "a production-equivalent recovery candidate does not complete independent review or authorize production promotion",
    "human production-promotion review remains a separate non-automatic decision authority",
    "production traffic and production credentials remain unnecessary and forbidden as automatic promotion shortcuts"
  ]
}
