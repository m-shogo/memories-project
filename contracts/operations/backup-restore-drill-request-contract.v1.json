{
  "contractId": "memory-os.operability.backup-restore-drill-request.v1",
  "schemaVersion": "memory-os-backup-restore-drill-request-contract.v1",
  "recordSchemaVersion": "memory-os-backup-restore-drill-request.v1",
  "approvalSchemaVersion": "memory-os-backup-restore-drill-request-approval.v2",
  "description": "Fail-closed planning admission for a production-equivalent cross-environment backup/restore drill. A request may be registered only after both referenced environment generations were registered and the bound recovery objective was explicitly approved; those generations must be distinct, unsuperseded and semantically restore-preflight eligible in distinct environments, and the objective must be current. Three distinct typed human approvals must bind the canonical digest of that exact request record and their exact bytes remain SHA-256 bound in the append-only request registry. Registered environment generation count is inventory only and must never be treated as semantic restore-preflight eligibility. Registration authorizes planning only: it never runs a backup, restore or traffic change, never creates production evidence, and must be revalidated immediately before execution.",
  "environmentGenerationRegistry": "contracts/operations/production-equivalent-environment-generation-registry.v1.json",
  "recoveryObjectivesRegistry": "contracts/operations/recovery-objectives-registry.v1.json",
  "requestRegistry": "contracts/operations/backup-restore-drill-request-registry.v1.json",
  "generationRecoveryContract": "contracts/operations/backup-restore-generation-evidence-contract.v1.json",
  "typedNonResurrectionContract": "contracts/operations/backup-restore-non-resurrection-admission-contract.v1.json",
  "writer": "scripts/request-memory-os-backup-restore-drill.py",
  "validator": "scripts/validate-memory-os-backup-restore-drill-request.py",
  "negativeAdmissionValidator": "scripts/validate-memory-os-backup-restore-drill-request-negative.py",
  "reconcile": "scripts/reconcile-memory-os-backup-restore-drill-request.py",
  "runbook": "docs/runbooks/memory-os-production-equivalent-backup-restore-drill.md",
  "workflow": ".github/workflows/backup-restore-drill-request.yml",
  "appendOnly": true,
  "requiredRequestFields": [
    "schemaVersion",
    "requestId",
    "requestedAt",
    "sourceEnvironmentGenerationId",
    "sourceEnvironmentManifestSha256",
    "restoreTargetEnvironmentGenerationId",
    "restoreTargetManifestSha256",
    "recoveryObjectivesId",
    "isolationPolicy",
    "databasePolicy",
    "objectPolicy",
    "requiredEvidenceDomains",
    "entryCriteriaRefs",
    "approvalRefs",
    "stopConditions",
    "openRisks",
    "productionTraffic",
    "productionCredentials",
    "automaticPromotion",
    "productionEvidence",
    "productionReady"
  ],
  "requiredApprovalFields": [
    "schemaVersion",
    "requestId",
    "requestRecordSha256",
    "reviewRole",
    "decision",
    "sourceEnvironmentGenerationId",
    "restoreTargetEnvironmentGenerationId",
    "recoveryObjectivesId",
    "approvedAt",
    "reviewerPseudonym",
    "productionTraffic",
    "productionCredentials",
    "automaticPromotion"
  ],
  "requiredApprovalRoles": {
    "recoveryOwner": "RECOVERY_OWNER",
    "securityReview": "SECURITY",
    "operabilityReview": "OPERABILITY"
  },
  "requiredEvidenceDomains": [
    "postgresqlPitrSelectionAndWalContinuity",
    "independentObjectRetentionAndExactVersionRestore",
    "measuredRpoSeconds",
    "measuredRtoSeconds",
    "measuredObjectDatabaseSkewSeconds",
    "databaseObjectRecoveryCoherence",
    "typedNonResurrectionEightDomainCoverage",
    "independentSecurityOperabilityAndRecoveryOwnerReview"
  ],
  "requiredStopConditions": [
    "source or restore-target generation no longer matches the approved manifest",
    "approved recovery objective changes before execution",
    "production traffic or production credentials become required",
    "PITR or WAL continuity cannot be independently verified",
    "exact object-version recovery authority is ambiguous",
    "database and object recovery points cannot be coherently bound",
    "deleted account/session, terminal session, replay, deletion-lease or idempotency invariant fails",
    "cross-tenant visibility or FORCE RLS/NOBYPASSRLS invariant fails",
    "measured RPO, RTO or object-database skew exceeds the approved objective",
    "security, operability or recovery-owner review is incomplete"
  ],
  "admissionRules": {
    "sourceGenerationMustExist": true,
    "restoreTargetGenerationMustExist": true,
    "registeredGenerationCountIsNotSemanticEligibility": true,
    "sourceGenerationMustBeUnsuperseded": true,
    "restoreTargetGenerationMustBeUnsuperseded": true,
    "sourceGenerationMustBeSemanticallyPreflightEligible": true,
    "restoreTargetGenerationMustBeSemanticallyPreflightEligible": true,
    "sourceAndTargetGenerationIdsMustDiffer": true,
    "sourceAndTargetEnvironmentIdsMustDiffer": true,
    "sourceManifestMustMatchRegisteredGeneration": true,
    "targetManifestMustMatchRegisteredGeneration": true,
    "requestMustNotPredateSourceGenerationRegistration": true,
    "requestMustNotPredateRestoreTargetGenerationRegistration": true,
    "recoveryObjectivesIdMustBeCurrentApprovedObjective": true,
    "requestMustNotPredateRecoveryObjectiveApproval": true,
    "isolatedNetworkRequired": true,
    "syntheticOrApprovedSanitizedDataOnly": true,
    "productionRoutingForbidden": true,
    "postgresPitrRequired": true,
    "walContinuityRequired": true,
    "destructiveDownMigrationForbidden": true,
    "independentObjectRetentionRequired": true,
    "exactObjectVersionRestoreRequired": true,
    "tlsRequired": true,
    "restoreOnlyCredentialSeparationRequired": true,
    "objectDeletionProtectionRequired": true,
    "objectImmutabilityRequired": true,
    "allRequiredEvidenceDomainsPlanned": true,
    "allRequiredStopConditionsPresent": true,
    "entryCriteriaRefsMustExist": true,
    "recoveryOwnerSecurityAndOperabilityApprovalsRequired": true,
    "approvalRefsMustBeDistinct": true,
    "approvalDocumentsMustUseTypedSchema": true,
    "approvalDocumentsMustBeApproved": true,
    "approvalDocumentsMustBindExactRequestId": true,
    "approvalDocumentsMustBindCanonicalRequestRecordDigest": true,
    "approvalEvidenceContentMustBeSha256BoundInRegistry": true,
    "approvalEvidenceDigestMapMustExactlyMatchRegisteredRequests": true,
    "approvalDocumentsMustNotPredateRequest": true,
    "approvalDocumentsMustBindExactSourceGeneration": true,
    "approvalDocumentsMustBindExactRestoreTargetGeneration": true,
    "approvalDocumentsMustBindExactCurrentRecoveryObjective": true,
    "approvalReviewRolesMustMatchApprovalRefRole": true,
    "approvalReviewerPseudonymsMustBeDistinct": true,
    "approvalReviewerPseudonymsMustBeCanonicalNonEmptyText": true,
    "approvalDocumentsMustForbidProductionTrafficCredentialsAndAutomaticPromotion": true,
    "productionTrafficForbidden": true,
    "productionCredentialsForbidden": true,
    "automaticPromotionForbidden": true,
    "productionEvidenceForbidden": true,
    "productionReadyForbidden": true,
    "uniqueRequestIdRequired": true,
    "uniqueSourceTargetObjectiveTupleRequired": true,
    "externalInputRequired": true,
    "cleanWorkingTreeRequired": true,
    "exclusiveLockAndAtomicRegistryUpdateRequired": true,
    "appendMustRevalidateCanonicalRegistryAndRollbackOnFailure": true,
    "executionTimeRevalidationRequired": true
  },
  "forbiddenAdmissionSources": [
    "local PostgreSQL logical restore evidence alone",
    "local MinIO exact-version restore evidence alone",
    "local coherent recovery-set evidence alone",
    "generic nonResurrectionVerification PASS",
    "unregistered environment identifier",
    "registered generation count without semantic restore-preflight eligibility",
    "registered but semantically restore-preflight-ineligible environment generation",
    "request timestamp predating source or restore-target generation registration",
    "superseded environment generation",
    "historical recovery objective that is no longer current",
    "request timestamp predating recovery objective approval",
    "arbitrary repository file used as human approval",
    "approval document for another request, generation pair or recovery objective",
    "approval document that does not bind the canonical request-record digest",
    "approval evidence content changed after append-only request registration",
    "approval evidence digest map missing, stale or containing unknown requests",
    "approval document timestamp that predates requestedAt",
    "approval document with mismatched review role or reused reviewer pseudonym",
    "branch head or mutable latest alias",
    "production traffic or production credentials",
    "automatic promotion decision"
  ],
  "environmentPolicy": {
    "class": "PRODUCTION_EQUIVALENT_ISOLATED_RESTORE_DRILL",
    "productionTrafficAllowed": false,
    "productionCredentialsAllowed": false,
    "syntheticOrApprovedSanitizedDataOnly": true,
    "automaticTrafficPromotionAllowed": false,
    "destructiveDownMigrationAllowed": false
  },
  "executionBoundary": {
    "planningAuthorityOnly": true,
    "requestAloneMayExecuteDrill": false,
    "requestMustBeRevalidatedImmediatelyBeforeExecution": true,
    "backupExecuted": false,
    "restoreExecuted": false,
    "productionTrafficChanged": false,
    "productionEvidence": false,
    "productionReady": false
  },
  "currentAdmissionState": {
    "registeredEnvironmentGenerationCount": 0,
    "preflightEligibleEnvironmentGenerationCount": 0,
    "unsupersededPreflightEligibleEnvironmentGenerationCount": 0,
    "distinctPreflightEligibleEnvironmentCount": 0,
    "eligibleDirectedSourceTargetPairCount": 0,
    "approvedRecoveryObjectiveCount": 0,
    "registeredRequestCount": 0,
    "currentExecutableRequestCount": 0,
    "admissionDecision": "BLOCKED_NO_REGISTERED_GENERATION_OR_APPROVED_OBJECTIVE",
    "productionEvidence": false,
    "productionReady": false,
    "productionDecision": "NO_GO"
  },
  "readiness": {
    "contractDefined": true,
    "registryImplemented": true,
    "writerImplemented": true,
    "validatorImplemented": true,
    "negativeAdmissionSuiteImplemented": true,
    "reconcileImplemented": true,
    "automaticWorkflowImplemented": true,
    "runbookDefined": true,
    "environmentGenerationAvailable": false,
    "semanticallyEligibleDistinctEnvironmentPairAvailable": false,
    "approvedRecoveryObjectivesAvailable": false,
    "drillRequested": false,
    "currentExecutableRequestAvailable": false,
    "drillExecuted": false,
    "independentReviewCompleted": false,
    "productionReady": false
  }
}
