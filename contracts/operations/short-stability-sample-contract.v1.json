{
  "contractId": "memory-os.operability.short-stability-sample.v1",
  "schemaVersion": "memory-os-short-stability-sample.v1",
  "resultsSchemaVersion": "memory-os-short-stability-sample-results.v1",
  "description": "A bounded multi-window CI sample over the authenticated Preview read path, recording process RSS, Go heap and goroutine observations. It is deliberately not a sustained soak, leak proof, production capacity result or approved operating threshold.",
  "scenarioId": "authenticated-preview-short-ci-stability-local-postgres",
  "dependencyMode": "LOCAL_POSTGRES",
  "classification": "SHORT_CI_STABILITY_SAMPLE",
  "windowCount": 6,
  "requestsPerWindow": 300,
  "concurrency": 16,
  "resultPath": "docs/fixtures/memory-os-operability/short-stability-sample-results.sample.v1.json",
  "runner": "services/import-api/internal/httpserver/short_stability_sample_test.go",
  "validator": "scripts/validate-memory-os-short-stability-sample.py",
  "reconcile": "scripts/reconcile-memory-os-short-stability-status.py",
  "workflow": ".github/workflows/short-stability-sample.yml",
  "requiredObservations": [
    "heapAllocBytes",
    "heapInuseBytes",
    "rssBytes",
    "goroutines",
    "window latency p50/p95/p99",
    "window throughput",
    "final-minus-baseline deltas",
    "linear slopes per window"
  ],
  "successCriteria": {
    "allWindowsExecuted": true,
    "allWindowsAll2xx": true,
    "allWindowsNo5xx": true,
    "allWindowsNoTransportErrors": true,
    "rssAvailable": true,
    "previewReadyRowsAfterSample": 1,
    "previewCandidateRowsAfterSample": 2,
    "previewRejectionRowsAfterSample": 1,
    "sustainedSoakEvidence": false,
    "leakProof": false,
    "capacityBoundaryEstablished": false,
    "operationalThresholdApproved": false,
    "productionEvidence": false
  },
  "interpretationRules": {
    "positiveSlopeIsNotAutomaticallyALeak": true,
    "flatSlopeIsNotLeakProof": true,
    "shortSampleCannotApproveCapacity": true,
    "shortSampleCannotApproveSoakReadiness": true,
    "requiredDecision": "SHORT_SAMPLE_ONLY",
    "sustainedSoakMinimumDurationMinutes": 60,
    "sustainedSoakRequiresRepeatedRuns": true,
    "sustainedSoakRequiresDependencyAndQueueCoverage": true
  },
  "abortCriteria": [
    "any 5xx or transport error",
    "any non-2xx response",
    "any Preview row-count mutation",
    "RSS cannot be observed on the Linux CI runner",
    "result would contain a token, account, job, Preview or database URL",
    "production traffic or production credentials are detected"
  ],
  "evidenceBoundary": {
    "syntheticDataOnly": true,
    "productionTraffic": false,
    "productionCredentials": false,
    "productionEvidence": false,
    "productionEquivalentDependencies": false,
    "sustainedSoakEvidence": false,
    "leakProof": false,
    "capacityBoundaryEstablished": false,
    "operationalThresholdApproved": false,
    "productionReady": false
  },
  "readiness": {
    "contractDefined": true,
    "runnerImplemented": true,
    "validatorImplemented": true,
    "automaticWorkflowImplemented": true,
    "exactSourceResultCommitted": true,
    "shortSampleExecuted": true,
    "sustainedSoakExecuted": false,
    "leakProofAvailable": false,
    "capacityBoundaryEstablished": false,
    "operationalThresholdApproved": false,
    "independentReviewCompleted": false,
    "productionReady": false
  },
  "limitations": [
    "six bounded windows rather than a 60-minute or longer soak",
    "single authenticated Preview read route",
    "local PostgreSQL and an ephemeral GitHub-hosted runner",
    "no measured MinIO operation, parser worker, queue, deletion worker or Apple dependency",
    "runtime.GC is invoked before observations to reduce transient noise",
    "Linux process RSS is sampled from /proc and is runner-specific",
    "no leak or production capacity conclusion is permitted"
  ]
}
