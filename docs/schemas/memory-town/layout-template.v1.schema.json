{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memory-os.example/schemas/memory-town/layout-template.v1.schema.json",
  "title": "Memory Town Layout Template v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "templateId",
    "templateVersion",
    "spatialSchemaVersion",
    "mapDefinitionId",
    "mapDefinitionVersion",
    "objectCatalogId",
    "objectCatalogVersion",
    "objects",
    "featureBindings",
    "pathCells",
    "decorationSlots"
  ],
  "properties": {
    "$schema": { "const": "https://memory-os.example/schemas/memory-town/layout-template.v1.schema.json" },
    "templateId": { "$ref": "core.v1.schema.json#/$defs/StableId" },
    "templateVersion": { "$ref": "core.v1.schema.json#/$defs/PositiveInteger" },
    "spatialSchemaVersion": { "type": "string", "minLength": 1, "maxLength": 128 },
    "mapDefinitionId": { "$ref": "core.v1.schema.json#/$defs/StableId" },
    "mapDefinitionVersion": { "$ref": "core.v1.schema.json#/$defs/PositiveInteger" },
    "objectCatalogId": { "$ref": "core.v1.schema.json#/$defs/StableId" },
    "objectCatalogVersion": { "$ref": "core.v1.schema.json#/$defs/PositiveInteger" },
    "objects": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5000,
      "items": { "$ref": "core.v1.schema.json#/$defs/TownObjectTemplatePlacement" }
    },
    "featureBindings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": { "$ref": "core.v1.schema.json#/$defs/TownFeatureBinding" }
    },
    "pathCells": {
      "type": "array",
      "maxItems": 65536,
      "items": { "$ref": "core.v1.schema.json#/$defs/TownPathCellState" }
    },
    "decorationSlots": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "slotIdSeed",
              "ownerInstanceIdSeed",
              "slotMode",
              "position",
              "allowedCategories",
              "allowedTags"
            ],
            "properties": {
              "slotIdSeed": { "$ref": "core.v1.schema.json#/$defs/StableId" },
              "ownerInstanceIdSeed": { "$ref": "core.v1.schema.json#/$defs/StableId" },
              "slotMode": { "const": "grid" },
              "position": { "$ref": "core.v1.schema.json#/$defs/TownGridPosition" },
              "allowedCategories": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "$ref": "core.v1.schema.json#/$defs/TownObjectCategory" }
              },
              "allowedTags": {
                "type": "array",
                "uniqueItems": true,
                "items": { "$ref": "core.v1.schema.json#/$defs/StableId" }
              },
              "occupiedByInstanceIdSeed": { "$ref": "core.v1.schema.json#/$defs/StableId" }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "slotIdSeed",
              "ownerInstanceIdSeed",
              "slotMode",
              "ownerOverlaySlotKey",
              "allowedCategories",
              "allowedTags"
            ],
            "properties": {
              "slotIdSeed": { "$ref": "core.v1.schema.json#/$defs/StableId" },
              "ownerInstanceIdSeed": { "$ref": "core.v1.schema.json#/$defs/StableId" },
              "slotMode": { "const": "overlay" },
              "ownerOverlaySlotKey": { "$ref": "core.v1.schema.json#/$defs/StableId" },
              "allowedCategories": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "$ref": "core.v1.schema.json#/$defs/TownObjectCategory" }
              },
              "allowedTags": {
                "type": "array",
                "uniqueItems": true,
                "items": { "$ref": "core.v1.schema.json#/$defs/StableId" }
              },
              "occupiedByInstanceIdSeed": { "$ref": "core.v1.schema.json#/$defs/StableId" }
            }
          }
        ]
      }
    }
  }
}
