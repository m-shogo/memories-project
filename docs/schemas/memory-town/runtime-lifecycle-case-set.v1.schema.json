{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memory-os.example/schemas/memory-town/runtime-lifecycle-case-set.v1.schema.json",
  "title": "Memory Town Runtime Lifecycle Case Set v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "caseSetId", "caseSetVersion", "cases"],
  "properties": {
    "$schema": { "const": "https://memory-os.example/schemas/memory-town/runtime-lifecycle-case-set.v1.schema.json" },
    "caseSetId": { "$ref": "core.v1.schema.json#/$defs/StableId" },
    "caseSetVersion": { "$ref": "core.v1.schema.json#/$defs/PositiveInteger" },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["caseId", "initial", "events", "expected"],
        "properties": {
          "caseId": { "$ref": "core.v1.schema.json#/$defs/StableId" },
          "initial": { "$ref": "#/$defs/RuntimeState" },
          "events": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": { "$ref": "#/$defs/Event" }
          },
          "expected": { "$ref": "#/$defs/Expected" }
        }
      }
    }
  },
  "$defs": {
    "LifecycleState": {
      "enum": ["idle", "initializing", "ready_paused", "ready_running", "context_lost", "degraded", "disposing", "disposed"]
    },
    "FallbackMode": { "enum": ["none", "functional", "layered_visual", "cached_snapshot"] },
    "AccessibilityMode": { "enum": ["spatial_overlay", "feature_list"] },
    "RuntimeState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generation", "lifecycle", "routeActive", "documentVisible", "motionLevel", "tickerRunning", "fallbackMode", "accessibilityMode", "pixiAccessibilityEnabled"],
      "properties": {
        "generation": { "$ref": "core.v1.schema.json#/$defs/NonNegativeInteger" },
        "lifecycle": { "$ref": "#/$defs/LifecycleState" },
        "routeActive": { "type": "boolean" },
        "documentVisible": { "type": "boolean" },
        "motionLevel": { "enum": ["off", "reduced", "full"] },
        "tickerRunning": { "type": "boolean" },
        "fallbackMode": { "$ref": "#/$defs/FallbackMode" },
        "accessibilityMode": { "$ref": "#/$defs/AccessibilityMode" },
        "pixiAccessibilityEnabled": { "type": "boolean" }
      }
    },
    "Event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "enum": [
            "route_enter",
            "route_leave",
            "app_init_started",
            "app_init_completed",
            "asset_load_completed",
            "scene_accepted",
            "document_hidden",
            "document_visible",
            "context_lost",
            "context_restored",
            "context_restore_failed",
            "motion_changed",
            "switch_accessibility_mode",
            "enable_pixi_accessibility",
            "destroy_completed"
          ]
        },
        "capturedGeneration": { "$ref": "core.v1.schema.json#/$defs/NonNegativeInteger" },
        "motionLevel": { "enum": ["off", "reduced", "full"] },
        "accessibilityMode": { "$ref": "#/$defs/AccessibilityMode" }
      }
    },
    "Expected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generation", "lifecycle", "tickerRunning", "fallbackMode", "focusableSemanticTargetsPerFeature", "staleCompletionsApplied"],
      "properties": {
        "generation": { "$ref": "core.v1.schema.json#/$defs/NonNegativeInteger" },
        "lifecycle": { "$ref": "#/$defs/LifecycleState" },
        "tickerRunning": { "type": "boolean" },
        "fallbackMode": { "$ref": "#/$defs/FallbackMode" },
        "focusableSemanticTargetsPerFeature": { "type": "integer", "minimum": 0, "maximum": 1 },
        "staleCompletionsApplied": { "const": 0 },
        "issueCodes": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" } }
      }
    }
  }
}
