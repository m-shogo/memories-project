{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memory-os.example/schemas/memory-town/access-connectivity-case-set.v1.schema.json",
  "title": "Memory Town Access Connectivity Case Set v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "caseSetId", "caseSetVersion", "cases"],
  "properties": {
    "$schema": { "const": "https://memory-os.example/schemas/memory-town/access-connectivity-case-set.v1.schema.json" },
    "caseSetId": { "$ref": "core.v1.schema.json#/$defs/StableId" },
    "caseSetVersion": { "$ref": "core.v1.schema.json#/$defs/PositiveInteger" },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["caseId", "accessRoots", "structures", "pathCells", "semanticConnections", "expected"],
        "properties": {
          "caseId": { "$ref": "core.v1.schema.json#/$defs/StableId" },
          "accessRoots": { "type": "array", "items": { "$ref": "#/$defs/AccessRoot" } },
          "structures": { "type": "array", "items": { "$ref": "#/$defs/Structure" } },
          "pathCells": { "type": "array", "items": { "$ref": "#/$defs/PathCell" } },
          "semanticConnections": { "type": "array", "items": { "$ref": "#/$defs/SemanticConnection" } },
          "bindingState": { "$ref": "#/$defs/BindingState" },
          "expected": { "$ref": "#/$defs/Expected" }
        }
      }
    }
  },
  "$defs": {
    "Position": { "$ref": "core.v1.schema.json#/$defs/TownGridPosition" },
    "AccessRoot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accessRootId", "position", "rootType", "enabled"],
      "properties": {
        "accessRootId": { "$ref": "core.v1.schema.json#/$defs/StableId" },
        "position": { "$ref": "#/$defs/Position" },
        "rootType": { "enum": ["central_plaza", "map_entry", "district_entry", "dock_network"] },
        "enabled": { "type": "boolean" }
      }
    },
    "Structure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instanceRef", "featureId", "placementState", "requiredAccessCells", "acceptablePathTypes", "minimumConnectedRoots"],
      "properties": {
        "instanceRef": { "type": "string", "minLength": 1, "maxLength": 160 },
        "featureId": { "$ref": "core.v1.schema.json#/$defs/StableId" },
        "placementState": { "$ref": "core.v1.schema.json#/$defs/TownPlacementState" },
        "requiredAccessCells": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/Position" } },
        "acceptablePathTypes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["road", "footpath", "plaza", "bridge"] } },
        "minimumConnectedRoots": { "type": "integer", "minimum": 1, "maximum": 16 }
      }
    },
    "PathCell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["position", "pathType"],
      "properties": {
        "position": { "$ref": "#/$defs/Position" },
        "pathType": { "enum": ["road", "footpath", "plaza", "bridge"] }
      }
    },
    "SemanticConnection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["connectionId", "fromFeatureId", "toFeatureId"],
      "properties": {
        "connectionId": { "$ref": "core.v1.schema.json#/$defs/StableId" },
        "fromFeatureId": { "$ref": "core.v1.schema.json#/$defs/StableId" },
        "toFeatureId": { "$ref": "core.v1.schema.json#/$defs/StableId" }
      }
    },
    "BindingState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["featureId", "primary", "portalFallbackAvailable", "domRouteAvailable"],
      "properties": {
        "featureId": { "$ref": "core.v1.schema.json#/$defs/StableId" },
        "primary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["instanceRef", "placementState", "definitionAvailable"],
          "properties": {
            "instanceRef": { "type": "string", "minLength": 1, "maxLength": 160 },
            "placementState": { "$ref": "core.v1.schema.json#/$defs/TownPlacementState" },
            "definitionAvailable": { "type": "boolean" }
          }
        },
        "portalFallbackAvailable": { "type": "boolean" },
        "secondaryRouteCapableAvailable": { "type": "boolean" },
        "domRouteAvailable": { "type": "boolean" }
      }
    },
    "Expected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spatialValid", "semanticConnectionsCountAsPaths", "featureRouteAvailable"],
      "properties": {
        "spatialValid": { "type": "boolean" },
        "semanticConnectionsCountAsPaths": { "const": false },
        "featureRouteAvailable": { "type": "boolean" },
        "resolvedVisualTarget": { "enum": ["primary", "portal", "secondary", "dom_only", "none"] },
        "issueCodes": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" } }
      }
    }
  }
}
