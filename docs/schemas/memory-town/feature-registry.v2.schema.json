{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memory-os.example/schemas/memory-town/feature-registry.v2.schema.json",
  "title": "Memory Town Feature Registry v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "registryId", "registryVersion", "growthRulesetVersion", "features"],
  "properties": {
    "$schema": { "const": "https://memory-os.example/schemas/memory-town/feature-registry.v2.schema.json" },
    "registryId": { "$ref": "core.v1.schema.json#/$defs/StableId" },
    "registryVersion": { "const": 2 },
    "growthRulesetVersion": { "type": "string", "minLength": 1, "maxLength": 128 },
    "features": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "featureId",
          "featureKind",
          "route",
          "defaultObjectDefinitionId",
          "currentEligibleAggregateKey",
          "growthContributionAggregateKey",
          "privacyAggregationPolicy",
          "stageThresholdBasis",
          "stageThresholds",
          "stagePersistence",
          "resetPolicy",
          "resetScope",
          "allowedBindingRoles"
        ],
        "properties": {
          "featureId": { "$ref": "core.v1.schema.json#/$defs/StableId" },
          "featureKind": { "enum": ["shelf", "box", "system", "reflection"] },
          "route": { "type": "string", "pattern": "^/[a-z0-9/_-]+$", "maxLength": 256 },
          "defaultObjectDefinitionId": { "$ref": "core.v1.schema.json#/$defs/StableId" },
          "currentEligibleAggregateKey": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$", "maxLength": 128 },
          "growthContributionAggregateKey": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$", "maxLength": 160 },
          "privacyAggregationPolicy": {
            "enum": [
              "exclude_hidden_sealed_restricted_deleted",
              "counts_only_no_item_titles",
              "aggregate_counts_only"
            ]
          },
          "stageThresholdBasis": { "const": "growth_eligible_contribution_count_since_origin" },
          "stageThresholds": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["stage", "minimumGrowthContributionCount"],
              "properties": {
                "stage": { "$ref": "core.v1.schema.json#/$defs/NonNegativeInteger" },
                "minimumGrowthContributionCount": { "$ref": "core.v1.schema.json#/$defs/NonNegativeInteger" }
              }
            }
          },
          "stagePersistence": { "const": "max_unlocked_until_explicit_reset" },
          "resetPolicy": { "const": "capture_projection_cursor_as_growth_origin" },
          "resetScope": { "const": "feature_or_town" },
          "allowedBindingRoles": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "enum": ["primary", "secondary", "portal"] }
          }
        }
      }
    }
  }
}
