{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memory-os.example/schemas/memory-town/command-batch-case-set.v1.schema.json",
  "title": "Memory Town Command Batch Case Set v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "caseSetId", "caseSetVersion", "cases"],
  "properties": {
    "$schema": { "const": "https://memory-os.example/schemas/memory-town/command-batch-case-set.v1.schema.json" },
    "caseSetId": { "$ref": "core.v1.schema.json#/$defs/StableId" },
    "caseSetVersion": { "$ref": "core.v1.schema.json#/$defs/PositiveInteger" },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["caseId", "input", "expected"],
        "properties": {
          "caseId": { "$ref": "core.v1.schema.json#/$defs/StableId" },
          "input": {
            "type": "object",
            "additionalProperties": false,
            "required": ["currentLayoutRevision", "batch"],
            "properties": {
              "currentLayoutRevision": { "$ref": "core.v1.schema.json#/$defs/NonNegativeInteger" },
              "previouslyAppliedBatchIds": {
                "type": "array",
                "maxItems": 10000,
                "uniqueItems": true,
                "items": { "type": "string", "minLength": 1, "maxLength": 160 }
              },
              "batch": { "$ref": "#/$defs/Batch" }
            }
          },
          "expected": { "$ref": "#/$defs/Expected" }
        }
      }
    }
  },
  "$defs": {
    "Batch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["batchId", "expectedLayoutRevision", "clientSessionId", "createdAt", "commands"],
      "properties": {
        "batchId": { "type": "string", "minLength": 1, "maxLength": 160 },
        "expectedLayoutRevision": { "$ref": "core.v1.schema.json#/$defs/NonNegativeInteger" },
        "clientSessionId": { "type": "string", "minLength": 1, "maxLength": 160 },
        "createdAt": { "$ref": "core.v1.schema.json#/$defs/UtcTimestamp" },
        "commands": {
          "type": "array",
          "minItems": 1,
          "maxItems": 500,
          "items": {
            "oneOf": [
              { "$ref": "#/$defs/MoveCommand" },
              { "$ref": "#/$defs/RotateCommand" },
              { "$ref": "#/$defs/PaintPathCommand" }
            ]
          }
        }
      }
    },
    "MoveCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commandId", "type", "instanceId", "from", "to"],
      "properties": {
        "commandId": { "type": "string", "minLength": 1, "maxLength": 160 },
        "type": { "const": "move_object" },
        "instanceId": { "type": "string", "minLength": 1, "maxLength": 160 },
        "from": { "$ref": "core.v1.schema.json#/$defs/TownGridPosition" },
        "to": { "$ref": "core.v1.schema.json#/$defs/TownGridPosition" }
      }
    },
    "RotateCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commandId", "type", "instanceId", "fromOrientation", "toOrientation"],
      "properties": {
        "commandId": { "type": "string", "minLength": 1, "maxLength": 160 },
        "type": { "const": "rotate_object" },
        "instanceId": { "type": "string", "minLength": 1, "maxLength": 160 },
        "fromOrientation": { "$ref": "core.v1.schema.json#/$defs/TownOrientation" },
        "toOrientation": { "$ref": "core.v1.schema.json#/$defs/TownOrientation" }
      }
    },
    "PaintPathCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commandId", "type", "pathType", "cells"],
      "properties": {
        "commandId": { "type": "string", "minLength": 1, "maxLength": 160 },
        "type": { "const": "paint_path" },
        "pathType": { "$ref": "core.v1.schema.json#/$defs/TownPathType" },
        "cells": {
          "type": "array",
          "minItems": 1,
          "maxItems": 500,
          "items": { "$ref": "core.v1.schema.json#/$defs/TownGridPosition" }
        }
      }
    },
    "Expected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "resultingLayoutRevision",
        "appliedCommandCount",
        "rejectedCommandCount",
        "eventCount",
        "snapshotCreated",
        "issues"
      ],
      "properties": {
        "status": { "enum": ["applied", "idempotent_replay", "rejected"] },
        "resultingLayoutRevision": { "$ref": "core.v1.schema.json#/$defs/NonNegativeInteger" },
        "appliedCommandCount": { "$ref": "core.v1.schema.json#/$defs/NonNegativeInteger" },
        "rejectedCommandCount": { "$ref": "core.v1.schema.json#/$defs/NonNegativeInteger" },
        "eventCount": { "$ref": "core.v1.schema.json#/$defs/NonNegativeInteger" },
        "snapshotCreated": { "type": "boolean" },
        "issues": {
          "type": "array",
          "maxItems": 1000,
          "items": { "$ref": "core.v1.schema.json#/$defs/TownIssue" }
        }
      }
    }
  }
}
