{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memory-os.example/schemas/memory-town/issue-code-registry.v1.schema.json",
  "title": "Memory Town Issue Code Registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "registryId", "registryVersion", "codes"],
  "properties": {
    "$schema": { "const": "https://memory-os.example/schemas/memory-town/issue-code-registry.v1.schema.json" },
    "registryId": { "$ref": "core.v1.schema.json#/$defs/StableId" },
    "registryVersion": { "$ref": "core.v1.schema.json#/$defs/PositiveInteger" },
    "codes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "layer", "defaultSeverity", "safeMessageKey", "retryable", "blocksApply", "mayIncludePrivateValue"],
        "properties": {
          "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$", "maxLength": 128 },
          "layer": { "enum": ["file", "schema", "reference", "semantic", "spatial", "state", "privacy", "concurrency", "migration", "security", "asset", "prototype"] },
          "defaultSeverity": { "enum": ["info", "warning", "error", "prototype_pending"] },
          "safeMessageKey": { "type": "string", "pattern": "^memoryTown\\.issue\\.[A-Za-z0-9_.-]+$", "maxLength": 200 },
          "retryable": { "type": "boolean" },
          "blocksApply": { "type": "boolean" },
          "mayIncludePrivateValue": { "const": false },
          "supersedes": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$", "maxLength": 128 },
          "deprecated": { "type": "boolean" }
        }
      }
    }
  }
}
