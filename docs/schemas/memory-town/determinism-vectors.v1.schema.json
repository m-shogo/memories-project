{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memory-os.example/schemas/memory-town/determinism-vectors.v1.schema.json",
  "title": "Memory Town Determinism Vectors v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "vectorSetId", "vectorSetVersion", "idAlgorithm", "instanceVectors", "bindingVectors", "canonicalJsonVectors"],
  "properties": {
    "$schema": { "const": "https://memory-os.example/schemas/memory-town/determinism-vectors.v1.schema.json" },
    "vectorSetId": { "$ref": "core.v1.schema.json#/$defs/StableId" },
    "vectorSetVersion": { "$ref": "core.v1.schema.json#/$defs/PositiveInteger" },
    "idAlgorithm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["encoding", "preimageFormat", "hash", "outputBits", "encodingAfterHash", "instancePrefix", "bindingPrefix"],
      "properties": {
        "encoding": { "const": "utf-8" },
        "preimageFormat": { "const": "namespace + NUL + templateId + NUL + decimalTemplateVersion + NUL + seed" },
        "hash": { "const": "sha-256" },
        "outputBits": { "const": 130 },
        "encodingAfterHash": { "const": "rfc4648-base32-lowercase-no-padding" },
        "instancePrefix": { "const": "townobj:tpl:" },
        "bindingPrefix": { "const": "townbinding:tpl:" }
      }
    },
    "instanceVectors": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/IdVector" }
    },
    "bindingVectors": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/IdVector" }
    },
    "canonicalJsonVectors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["caseId", "input", "arraySemantic", "expectedCanonicalJson", "expectedSha256Hex"],
        "properties": {
          "caseId": { "$ref": "core.v1.schema.json#/$defs/StableId" },
          "input": { "type": "array" },
          "arraySemantic": { "enum": ["set_sorted_by_elevation_y_x", "ordered"] },
          "expectedCanonicalJson": { "type": "string", "minLength": 1, "maxLength": 1048576 },
          "expectedSha256Hex": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    }
  },
  "$defs": {
    "IdVector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["namespace", "templateId", "templateVersion", "seed", "sha256Hex", "base32First130Bits", "expectedId"],
      "properties": {
        "namespace": { "type": "string", "minLength": 1, "maxLength": 128 },
        "templateId": { "$ref": "core.v1.schema.json#/$defs/StableId" },
        "templateVersion": { "$ref": "core.v1.schema.json#/$defs/PositiveInteger" },
        "seed": { "$ref": "core.v1.schema.json#/$defs/StableId" },
        "sha256Hex": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "base32First130Bits": { "type": "string", "pattern": "^[a-z2-7]{26}$" },
        "expectedId": { "type": "string", "minLength": 1, "maxLength": 160 }
      }
    }
  }
}
