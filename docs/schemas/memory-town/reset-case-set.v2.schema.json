{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memory-os.example/schemas/memory-town/reset-case-set.v2.schema.json",
  "title": "Memory Town Reset Case Set v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "caseSetId", "caseSetVersion", "globalRules", "cases"],
  "properties": {
    "$schema": { "const": "https://memory-os.example/schemas/memory-town/reset-case-set.v2.schema.json" },
    "caseSetId": { "$ref": "core.v1.schema.json#/$defs/StableId" },
    "caseSetVersion": { "const": 2 },
    "globalRules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "memoryDomainMayBeModified",
        "resetRequiresPreview",
        "resetRequiresExplicitConfirmation",
        "snapshotBeforeApply",
        "applyMode",
        "defaultUserObjectDisposition",
        "featureResetCapturesProjectionCursor"
      ],
      "properties": {
        "memoryDomainMayBeModified": { "const": false },
        "resetRequiresPreview": { "const": true },
        "resetRequiresExplicitConfirmation": { "const": true },
        "snapshotBeforeApply": { "const": true },
        "applyMode": { "const": "atomic" },
        "defaultUserObjectDisposition": { "const": "stored_not_deleted" },
        "featureResetCapturesProjectionCursor": { "const": true }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["caseId", "command", "expected"],
        "properties": {
          "caseId": { "$ref": "core.v1.schema.json#/$defs/StableId" },
          "command": { "$ref": "#/$defs/ResetCommand" },
          "expected": { "$ref": "#/$defs/Expected" }
        }
      }
    }
  },
  "$defs": {
    "OpaqueCursor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "ResetFeatureProgress": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commandId",
        "type",
        "featureId",
        "expectedResetEpoch",
        "expectedProjectionCursor",
        "reason"
      ],
      "properties": {
        "commandId": { "type": "string", "minLength": 1, "maxLength": 160 },
        "type": { "enum": ["reset_feature_progress", "privacy_reset_feature"] },
        "featureId": { "$ref": "core.v1.schema.json#/$defs/StableId" },
        "expectedResetEpoch": { "$ref": "core.v1.schema.json#/$defs/NonNegativeInteger" },
        "expectedProjectionCursor": { "$ref": "#/$defs/OpaqueCursor" },
        "reason": { "enum": ["user_requested_visual_reset", "privacy_reset"] },
        "removeBadges": { "type": "boolean" },
        "removeSemanticOverlays": { "type": "boolean" },
        "removeFeatureBindings": { "type": "boolean" }
      }
    },
    "ResetLayout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commandId", "type", "expectedLayoutRevision", "templateId", "templateVersion", "userObjectDisposition"],
      "properties": {
        "commandId": { "type": "string", "minLength": 1, "maxLength": 160 },
        "type": { "const": "reset_layout_to_template" },
        "expectedLayoutRevision": { "$ref": "core.v1.schema.json#/$defs/NonNegativeInteger" },
        "templateId": { "$ref": "core.v1.schema.json#/$defs/StableId" },
        "templateVersion": { "$ref": "core.v1.schema.json#/$defs/PositiveInteger" },
        "userObjectDisposition": { "enum": ["stored", "explicit_delete"] }
      }
    },
    "ResetDecorations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commandId", "type", "expectedLayoutRevision", "categories", "originFilter", "userObjectDisposition"],
      "properties": {
        "commandId": { "type": "string", "minLength": 1, "maxLength": 160 },
        "type": { "const": "reset_decorations" },
        "expectedLayoutRevision": { "$ref": "core.v1.schema.json#/$defs/NonNegativeInteger" },
        "categories": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "core.v1.schema.json#/$defs/TownObjectCategory" }
        },
        "originFilter": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "core.v1.schema.json#/$defs/TownObjectOrigin" }
        },
        "userObjectDisposition": { "enum": ["stored", "explicit_delete"] }
      }
    },
    "ResetEnvironment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commandId", "type", "themeId"],
      "properties": {
        "commandId": { "type": "string", "minLength": 1, "maxLength": 160 },
        "type": { "const": "reset_environment_preferences" },
        "themeId": { "$ref": "core.v1.schema.json#/$defs/StableId" }
      }
    },
    "ResetEntireTown": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commandId",
        "type",
        "expectedLayoutRevision",
        "templateId",
        "templateVersion",
        "featureResetInputs",
        "resetEnvironmentPreferences",
        "userObjectDisposition"
      ],
      "properties": {
        "commandId": { "type": "string", "minLength": 1, "maxLength": 160 },
        "type": { "const": "reset_entire_town" },
        "expectedLayoutRevision": { "$ref": "core.v1.schema.json#/$defs/NonNegativeInteger" },
        "templateId": { "$ref": "core.v1.schema.json#/$defs/StableId" },
        "templateVersion": { "$ref": "core.v1.schema.json#/$defs/PositiveInteger" },
        "featureResetInputs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["featureId", "expectedResetEpoch", "expectedProjectionCursor"],
            "properties": {
              "featureId": { "$ref": "core.v1.schema.json#/$defs/StableId" },
              "expectedResetEpoch": { "$ref": "core.v1.schema.json#/$defs/NonNegativeInteger" },
              "expectedProjectionCursor": { "$ref": "#/$defs/OpaqueCursor" }
            }
          }
        },
        "resetEnvironmentPreferences": { "type": "boolean" },
        "userObjectDisposition": { "enum": ["stored", "explicit_delete"] }
      }
    },
    "ResetCommand": {
      "oneOf": [
        { "$ref": "#/$defs/ResetFeatureProgress" },
        { "$ref": "#/$defs/ResetLayout" },
        { "$ref": "#/$defs/ResetDecorations" },
        { "$ref": "#/$defs/ResetEnvironment" },
        { "$ref": "#/$defs/ResetEntireTown" }
      ]
    },
    "Expected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["memoryDomainChanged"],
      "properties": {
        "memoryDomainChanged": { "const": false },
        "featureProgressChanges": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["featureId", "maxUnlockedStage", "resetEpoch", "growthOriginCursor"],
            "properties": {
              "featureId": { "$ref": "core.v1.schema.json#/$defs/StableId" },
              "maxUnlockedStage": { "$ref": "core.v1.schema.json#/$defs/NonNegativeInteger" },
              "resetEpoch": { "$ref": "core.v1.schema.json#/$defs/NonNegativeInteger" },
              "growthOriginCursor": { "$ref": "#/$defs/OpaqueCursor" }
            }
          }
        },
        "featureProgressChanged": { "type": "boolean" },
        "layoutChanged": { "type": "boolean" },
        "environmentChanged": { "type": "boolean" },
        "layoutRevisionFrom": { "$ref": "core.v1.schema.json#/$defs/NonNegativeInteger" },
        "layoutRevisionTo": { "$ref": "core.v1.schema.json#/$defs/NonNegativeInteger" },
        "templateObjectsRestored": { "type": "boolean" },
        "templateRestored": { "type": "boolean" },
        "systemStructuresChanged": { "type": "boolean" },
        "physicalPathsChanged": { "type": "boolean" },
        "userObjectsDeleted": { "$ref": "core.v1.schema.json#/$defs/NonNegativeInteger" },
        "userObjectsStored": { "$ref": "core.v1.schema.json#/$defs/NonNegativeInteger" },
        "environment": { "type": "object" },
        "environmentReset": { "type": "boolean" },
        "badgesRemoved": { "type": "boolean" },
        "semanticOverlaysRemoved": { "type": "boolean" },
        "primaryBindingPreserved": { "type": "boolean" },
        "rawDeletedMemoryRetainedAnywhereInTown": { "const": false },
        "rollbackSnapshotCreated": { "type": "boolean" }
      }
    }
  }
}
