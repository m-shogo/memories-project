{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memory-os.example/schemas/memory-town/worker-fence-case-set.v1.schema.json",
  "title": "Memory Town Worker Fence Case Set v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "caseSetId", "caseSetVersion", "cases"],
  "properties": {
    "$schema": { "const": "https://memory-os.example/schemas/memory-town/worker-fence-case-set.v1.schema.json" },
    "caseSetId": { "$ref": "core.v1.schema.json#/$defs/StableId" },
    "caseSetVersion": { "$ref": "core.v1.schema.json#/$defs/PositiveInteger" },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["caseId", "job", "currentFence", "expected"],
        "properties": {
          "caseId": { "$ref": "core.v1.schema.json#/$defs/StableId" },
          "job": { "$ref": "#/$defs/Job" },
          "currentFence": { "$ref": "#/$defs/CurrentFence" },
          "expected": { "$ref": "#/$defs/Expected" }
        }
      }
    }
  },
  "$defs": {
    "Job": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jobId", "jobType", "expectedDeletionEpoch", "expectedAccountState"],
      "properties": {
        "jobId": { "type": "string", "minLength": 1, "maxLength": 160 },
        "jobType": {
          "enum": [
            "feature_projection",
            "feature_unlock",
            "scene_snapshot",
            "layout_migration",
            "thumbnail_generation",
            "asset_manifest_refresh",
            "layout_command_batch",
            "reset",
            "repair"
          ]
        },
        "expectedDeletionEpoch": { "$ref": "core.v1.schema.json#/$defs/NonNegativeInteger" },
        "expectedAccountState": { "const": "active" },
        "expectedLayoutRevision": { "$ref": "core.v1.schema.json#/$defs/NonNegativeInteger" },
        "expectedMutationMode": { "enum": ["normal", "user_edit_session", "migration_locked", "reset_locked", "repair_locked"] },
        "expectedFenceToken": { "type": "string", "minLength": 1, "maxLength": 160 },
        "expectedResetEpoch": { "$ref": "core.v1.schema.json#/$defs/NonNegativeInteger" },
        "expectedGrowthOriginCursor": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    },
    "CurrentFence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accountState", "deletionEpoch", "layoutRevision", "mutationMode"],
      "properties": {
        "accountState": { "enum": ["active", "deletion_requested", "deleting", "deleted"] },
        "deletionEpoch": { "$ref": "core.v1.schema.json#/$defs/NonNegativeInteger" },
        "layoutRevision": { "$ref": "core.v1.schema.json#/$defs/NonNegativeInteger" },
        "mutationMode": { "enum": ["normal", "user_edit_session", "migration_locked", "reset_locked", "repair_locked"] },
        "fenceToken": { "type": "string", "minLength": 1, "maxLength": 160 },
        "resetEpoch": { "$ref": "core.v1.schema.json#/$defs/NonNegativeInteger" },
        "growthOriginCursor": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    },
    "Expected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["writeAllowed", "retryAllowed", "rowsWritten"],
      "properties": {
        "writeAllowed": { "type": "boolean" },
        "retryAllowed": { "type": "boolean" },
        "rowsWritten": { "$ref": "core.v1.schema.json#/$defs/NonNegativeInteger" },
        "issueCode": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$", "maxLength": 128 }
      },
      "allOf": [
        {
          "if": { "properties": { "writeAllowed": { "const": false } }, "required": ["writeAllowed"] },
          "then": { "required": ["issueCode"], "properties": { "rowsWritten": { "const": 0 } } }
        }
      ]
    }
  }
}
