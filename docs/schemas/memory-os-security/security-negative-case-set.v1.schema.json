{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memory-os.example/schemas/security/security-negative-case-set.v1.schema.json",
  "title": "Memory OS Security Negative Case Set v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "caseSetId", "caseSetVersion", "cases"],
  "properties": {
    "$schema": { "const": "https://memory-os.example/schemas/security/security-negative-case-set.v1.schema.json" },
    "caseSetId": { "$ref": "core.v1.schema.json#/$defs/StableId" },
    "caseSetVersion": { "type": "integer", "minimum": 1 },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["caseId", "targetSchemaId", "baseFixtureRef", "mutation", "expectedIssueCode", "expectedResult"],
        "properties": {
          "caseId": { "$ref": "core.v1.schema.json#/$defs/StableId" },
          "targetSchemaId": { "type": "string", "format": "uri", "maxLength": 300 },
          "baseFixtureRef": { "type": "string", "minLength": 1, "maxLength": 300 },
          "mutation": {
            "type": "object",
            "additionalProperties": false,
            "required": ["op", "path"],
            "properties": {
              "op": { "enum": ["add", "replace", "remove"] },
              "path": { "type": "string", "pattern": "^/", "maxLength": 512 },
              "value": {}
            }
          },
          "expectedIssueCode": { "type": "string", "pattern": "^SEC_[A-Z0-9_]+$", "maxLength": 128 },
          "expectedResult": { "enum": ["schema_reject", "semantic_reject", "authorization_reject"] }
        }
      }
    }
  }
}
