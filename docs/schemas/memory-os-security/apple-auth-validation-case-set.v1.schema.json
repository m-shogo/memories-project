{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memory-os.example/schemas/security/apple-auth-validation-case-set.v1.schema.json",
  "title": "Memory OS Sign in with Apple Validation Case Set v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "caseSetId", "caseSetVersion", "profileRef", "cases"],
  "properties": {
    "$schema": { "const": "https://memory-os.example/schemas/security/apple-auth-validation-case-set.v1.schema.json" },
    "caseSetId": { "$ref": "core.v1.schema.json#/$defs/StableId" },
    "caseSetVersion": { "type": "integer", "minimum": 1 },
    "profileRef": { "type": "string", "minLength": 1, "maxLength": 300 },
    "cases": {
      "type": "array", "minItems": 1, "maxItems": 1000,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": [
          "caseId", "issuer", "audience", "algorithm", "kidKnownBeforeRefresh",
          "kidKnownAfterRefresh", "signatureValid", "tokenExpired",
          "issuedAtWithinWindow", "noncePresent", "nonceMatches", "subjectPresent",
          "authorizationCodeAlreadyUsed", "authorizationCodeClientMatches",
          "authorizationCodeRedirectMatches", "emailOnlyLinkAttempt",
          "accountBindingConflict", "expectedDecision", "expectedIssueCode"
        ],
        "properties": {
          "caseId": { "$ref": "core.v1.schema.json#/$defs/StableId" },
          "issuer": { "type": "string", "minLength": 1, "maxLength": 255 },
          "audience": { "type": "string", "minLength": 1, "maxLength": 255 },
          "algorithm": { "type": "string", "minLength": 1, "maxLength": 32 },
          "kidKnownBeforeRefresh": { "type": "boolean" },
          "kidKnownAfterRefresh": { "type": "boolean" },
          "signatureValid": { "type": "boolean" },
          "tokenExpired": { "type": "boolean" },
          "issuedAtWithinWindow": { "type": "boolean" },
          "noncePresent": { "type": "boolean" },
          "nonceMatches": { "type": "boolean" },
          "subjectPresent": { "type": "boolean" },
          "authorizationCodeAlreadyUsed": { "type": "boolean" },
          "authorizationCodeClientMatches": { "type": "boolean" },
          "authorizationCodeRedirectMatches": { "type": "boolean" },
          "emailOnlyLinkAttempt": { "type": "boolean" },
          "accountBindingConflict": { "type": "boolean" },
          "expectedDecision": { "enum": ["allow", "deny"] },
          "expectedIssueCode": { "type": "string", "pattern": "^SEC_[A-Z0-9_]+$", "maxLength": 128 }
        }
      }
    }
  }
}
