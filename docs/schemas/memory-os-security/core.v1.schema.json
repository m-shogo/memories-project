{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memory-os.example/schemas/security/core.v1.schema.json",
  "title": "Memory OS Security Core Types v1",
  "$defs": {
    "StableId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[a-z][a-z0-9]*(?:[._:-][a-z0-9]+)*$"
    },
    "OpaqueId": {
      "type": "string",
      "minLength": 16,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "Sha256Hex": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "UtcTimestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "AccountEpoch": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "PositiveBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10737418240
    },
    "SafeString": {
      "type": "string",
      "maxLength": 256
    },
    "AccountOwnedRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ownerAccountId", "accountEpoch"],
      "properties": {
        "ownerAccountId": { "$ref": "#/$defs/OpaqueId" },
        "accountEpoch": { "$ref": "#/$defs/AccountEpoch" }
      }
    }
  }
}
