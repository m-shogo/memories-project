{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memory-os.example/schemas/security/security-issue-code-registry.v1.schema.json",
  "title": "Memory OS Security Issue Code Registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "registryId", "registryVersion", "codes"],
  "properties": {
    "$schema": { "const": "https://memory-os.example/schemas/security/security-issue-code-registry.v1.schema.json" },
    "registryId": { "$ref": "core.v1.schema.json#/$defs/StableId" },
    "registryVersion": { "type": "integer", "minimum": 1 },
    "codes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "category", "severity", "blocksApply", "retryable", "safeMessageKey", "mayIncludePrivateValue"],
        "properties": {
          "code": { "type": "string", "pattern": "^SEC_[A-Z0-9_]+$", "maxLength": 128 },
          "category": { "enum": ["identity", "authorization", "pairing", "upload", "quarantine", "parser", "preview_apply", "ios_storage", "portal", "deletion", "logging", "supply_chain"] },
          "severity": { "enum": ["critical", "high", "medium", "low", "info"] },
          "blocksApply": { "type": "boolean" },
          "retryable": { "type": "boolean" },
          "safeMessageKey": { "type": "string", "pattern": "^memoryOS\\.security\\.[A-Za-z0-9_.-]+$", "maxLength": 200 },
          "mayIncludePrivateValue": { "const": false }
        }
      }
    }
  }
}
