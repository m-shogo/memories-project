{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memory-os.example/schemas/security/authorization-case-set.v1.schema.json",
  "title": "Memory OS Object Authorization Case Set v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "caseSetId", "caseSetVersion", "matrixRef", "cases"],
  "properties": {
    "$schema": { "const": "https://memory-os.example/schemas/security/authorization-case-set.v1.schema.json" },
    "caseSetId": { "$ref": "core.v1.schema.json#/$defs/StableId" },
    "caseSetVersion": { "type": "integer", "minimum": 1 },
    "matrixRef": { "type": "string", "minLength": 1, "maxLength": 300 },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["caseId", "resourceType", "operation", "authority", "principalAccountId", "principalEpoch", "resourceOwnerAccountId", "resourceEpoch", "objectLookupPerformed", "queryOwnerScoped", "expectedDecision", "expectedIssueCode"],
        "properties": {
          "caseId": { "$ref": "core.v1.schema.json#/$defs/StableId" },
          "resourceType": { "enum": ["import_job", "pairing_session", "upload_authorization", "quarantine_object", "import_preview", "apply_confirmation", "import_report", "export", "deletion_fence"] },
          "operation": { "enum": ["create", "read", "list", "update", "delete", "cancel", "confirm", "download"] },
          "authority": { "enum": ["ios_user_access_token", "ios_device_session", "browser_pairing_token", "worker_lease", "deletion_worker", "support_break_glass"] },
          "principalAccountId": { "$ref": "core.v1.schema.json#/$defs/OpaqueId" },
          "principalEpoch": { "$ref": "core.v1.schema.json#/$defs/AccountEpoch" },
          "resourceOwnerAccountId": { "$ref": "core.v1.schema.json#/$defs/OpaqueId" },
          "resourceEpoch": { "$ref": "core.v1.schema.json#/$defs/AccountEpoch" },
          "objectLookupPerformed": { "type": "boolean" },
          "queryOwnerScoped": { "type": "boolean" },
          "expectedDecision": { "enum": ["allow", "deny"] },
          "expectedIssueCode": { "type": "string", "pattern": "^SEC_[A-Z0-9_]+$", "maxLength": 128 }
        }
      }
    }
  }
}
