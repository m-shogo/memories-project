{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memory-os.example/schemas/security/preview-spool-manifest.v1.schema.json",
  "title": "Memory OS Preview Spool Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "spoolId",
    "jobId",
    "ownerAccountId",
    "accountEpoch",
    "source",
    "adapter",
    "optionsSha256",
    "sourceRowCount",
    "spoolByteLength",
    "streams",
    "createdAt",
    "expiresAt",
    "security"
  ],
  "properties": {
    "$schema": {
      "const": "https://memory-os.example/schemas/security/preview-spool-manifest.v1.schema.json"
    },
    "schemaVersion": {
      "const": 1
    },
    "spoolId": {
      "$ref": "core.v1.schema.json#/$defs/OpaqueId"
    },
    "jobId": {
      "$ref": "core.v1.schema.json#/$defs/OpaqueId"
    },
    "ownerAccountId": {
      "$ref": "core.v1.schema.json#/$defs/OpaqueId"
    },
    "accountEpoch": {
      "$ref": "core.v1.schema.json#/$defs/AccountEpoch"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "objectKey",
        "objectVersionId",
        "contentLength",
        "checksumSha256"
      ],
      "properties": {
        "objectKey": {
          "type": "string",
          "minLength": 12,
          "maxLength": 256,
          "pattern": "^quarantine/[A-Za-z0-9][A-Za-z0-9._:/-]*$",
          "not": {
            "pattern": "(?:^|/)\\.\\.(?:/|$)"
          }
        },
        "objectVersionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9._~:+/=-]+$"
        },
        "contentLength": {
          "type": "integer",
          "minimum": 1,
          "maximum": 268435456
        },
        "checksumSha256": {
          "$ref": "core.v1.schema.json#/$defs/Sha256Hex"
        }
      }
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapterId",
        "adapterVersion",
        "artifactSha256"
      ],
      "properties": {
        "adapterId": {
          "$ref": "core.v1.schema.json#/$defs/StableId"
        },
        "adapterVersion": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "maxLength": 32
        },
        "artifactSha256": {
          "$ref": "core.v1.schema.json#/$defs/Sha256Hex"
        }
      }
    },
    "optionsSha256": {
      "$ref": "core.v1.schema.json#/$defs/Sha256Hex"
    },
    "sourceRowCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000
    },
    "spoolByteLength": {
      "type": "integer",
      "minimum": 1,
      "maximum": 536870912
    },
    "streams": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accepted",
        "rejected"
      ],
      "properties": {
        "accepted": {
          "$ref": "#/$defs/acceptedStreamBinding"
        },
        "rejected": {
          "$ref": "#/$defs/rejectedStreamBinding"
        }
      }
    },
    "createdAt": {
      "$ref": "core.v1.schema.json#/$defs/UtcTimestamp"
    },
    "expiresAt": {
      "$ref": "core.v1.schema.json#/$defs/UtcTimestamp"
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "supervisorOwned",
        "sealedBeforeVerification",
        "rehashRequiredBeforeCommit",
        "databaseTransactionDuringParseAllowed",
        "rawRejectedValuesAllowed",
        "manifestPathFieldsAllowed",
        "symlinkFollowingAllowed",
        "crossAttemptReuseAllowed",
        "backupEligible"
      ],
      "properties": {
        "supervisorOwned": {
          "const": true
        },
        "sealedBeforeVerification": {
          "const": true
        },
        "rehashRequiredBeforeCommit": {
          "const": true
        },
        "databaseTransactionDuringParseAllowed": {
          "const": false
        },
        "rawRejectedValuesAllowed": {
          "const": false
        },
        "manifestPathFieldsAllowed": {
          "const": false
        },
        "symlinkFollowingAllowed": {
          "const": false
        },
        "crossAttemptReuseAllowed": {
          "const": false
        },
        "backupEligible": {
          "const": false
        }
      }
    }
  },
  "$defs": {
    "acceptedStreamBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recordFormat",
        "recordCount",
        "byteLength",
        "sha256"
      ],
      "properties": {
        "recordFormat": {
          "const": "memory-os-preview-candidate-v1-length-prefixed"
        },
        "recordCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "byteLength": {
          "type": "integer",
          "minimum": 1,
          "maximum": 536870912
        },
        "sha256": {
          "$ref": "core.v1.schema.json#/$defs/Sha256Hex"
        }
      }
    },
    "rejectedStreamBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recordFormat",
        "recordCount",
        "byteLength",
        "sha256"
      ],
      "properties": {
        "recordFormat": {
          "const": "memory-os-preview-rejection-v1-length-prefixed"
        },
        "recordCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 99999
        },
        "byteLength": {
          "type": "integer",
          "minimum": 0,
          "maximum": 536870912
        },
        "sha256": {
          "$ref": "core.v1.schema.json#/$defs/Sha256Hex"
        }
      }
    }
  }
}
