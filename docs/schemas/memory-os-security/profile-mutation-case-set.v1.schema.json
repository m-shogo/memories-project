{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memory-os.example/schemas/security/profile-mutation-case-set.v1.schema.json",
  "title": "Memory OS Security Profile Mutation Case Set v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "caseSetId", "caseSetVersion", "baseFixtureRef", "targetSchemaId", "cases"],
  "properties": {
    "$schema": { "const": "https://memory-os.example/schemas/security/profile-mutation-case-set.v1.schema.json" },
    "caseSetId": { "$ref": "core.v1.schema.json#/$defs/StableId" },
    "caseSetVersion": { "type": "integer", "minimum": 1 },
    "baseFixtureRef": { "type": "string", "minLength": 1, "maxLength": 300 },
    "targetSchemaId": { "type": "string", "pattern": "^https://memory-os\\.example/schemas/security/", "maxLength": 300 },
    "cases": {
      "type": "array", "minItems": 1, "maxItems": 1000,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["caseId", "mutation", "expectedDecision", "expectedIssueCode"],
        "properties": {
          "caseId": { "$ref": "core.v1.schema.json#/$defs/StableId" },
          "mutation": {
            "type": "object", "additionalProperties": false,
            "required": ["path", "value"],
            "properties": {
              "path": { "type": "string", "pattern": "^/", "maxLength": 1024 },
              "value": {}
            }
          },
          "expectedDecision": { "const": "deny" },
          "expectedIssueCode": { "type": "string", "pattern": "^SEC_[A-Z0-9_]+$", "maxLength": 128 }
        }
      }
    }
  }
}
