{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memory-os.example/schemas/security/import-preview.v1.schema.json",
  "title": "Memory OS Import Preview v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "previewId", "jobId", "ownerAccountId", "accountEpoch", "state", "adapter", "sourceObjectHash", "parsingOptionsHash", "candidateSetHash", "previewHash", "counts", "createdAt", "expiresAt", "security"],
  "properties": {
    "$schema": { "const": "https://memory-os.example/schemas/security/import-preview.v1.schema.json" },
    "schemaVersion": { "const": 1 },
    "previewId": { "$ref": "core.v1.schema.json#/$defs/OpaqueId" },
    "jobId": { "$ref": "core.v1.schema.json#/$defs/OpaqueId" },
    "ownerAccountId": { "$ref": "core.v1.schema.json#/$defs/OpaqueId" },
    "accountEpoch": { "$ref": "core.v1.schema.json#/$defs/AccountEpoch" },
    "state": { "enum": ["materialized", "expired", "superseded"] },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapterId", "adapterVersion", "artifactDigest"],
      "properties": {
        "adapterId": { "$ref": "core.v1.schema.json#/$defs/StableId" },
        "adapterVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$", "maxLength": 32 },
        "artifactDigest": { "$ref": "core.v1.schema.json#/$defs/Sha256Hex" }
      }
    },
    "sourceObjectHash": { "$ref": "core.v1.schema.json#/$defs/Sha256Hex" },
    "parsingOptionsHash": { "$ref": "core.v1.schema.json#/$defs/Sha256Hex" },
    "candidateSetHash": { "$ref": "core.v1.schema.json#/$defs/Sha256Hex" },
    "previewHash": { "$ref": "core.v1.schema.json#/$defs/Sha256Hex" },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate", "duplicate", "rejected", "warning"],
      "properties": {
        "candidate": { "type": "integer", "minimum": 0, "maximum": 10000000 },
        "duplicate": { "type": "integer", "minimum": 0, "maximum": 10000000 },
        "rejected": { "type": "integer", "minimum": 0, "maximum": 10000000 },
        "warning": { "type": "integer", "minimum": 0, "maximum": 10000000 }
      }
    },
    "warningCodes": { "type": "array", "maxItems": 1000, "uniqueItems": true, "items": { "type": "string", "pattern": "^(SEC|IMP)_[A-Z0-9_]+$", "maxLength": 128 } },
    "createdAt": { "$ref": "core.v1.schema.json#/$defs/UtcTimestamp" },
    "expiresAt": { "$ref": "core.v1.schema.json#/$defs/UtcTimestamp" },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "required": ["immutable", "applyRequiresExactHash", "reparseAtApplyAllowed", "rawContentInMetadataAllowed"],
      "properties": {
        "immutable": { "const": true },
        "applyRequiresExactHash": { "const": true },
        "reparseAtApplyAllowed": { "const": false },
        "rawContentInMetadataAllowed": { "const": false }
      }
    }
  }
}
