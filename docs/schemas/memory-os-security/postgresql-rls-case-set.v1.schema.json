{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memory-os.example/schemas/security/postgresql-rls-case-set.v1.schema.json",
  "title": "Memory OS PostgreSQL RLS Case Set v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "caseSetId", "caseSetVersion", "contractRef", "cases"],
  "properties": {
    "$schema": { "const": "https://memory-os.example/schemas/security/postgresql-rls-case-set.v1.schema.json" },
    "caseSetId": { "$ref": "core.v1.schema.json#/$defs/StableId" },
    "caseSetVersion": { "type": "integer", "minimum": 1 },
    "contractRef": { "type": "string", "minLength": 1, "maxLength": 300 },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["caseId", "table", "command", "runtimeRole", "sessionContextPresent", "sessionAccountId", "sessionEpoch", "rowOwnerAccountId", "rowEpoch", "expectedDecision", "expectedIssueCode"],
        "properties": {
          "caseId": { "$ref": "core.v1.schema.json#/$defs/StableId" },
          "table": { "enum": ["import_job", "pairing_session", "upload_authorization", "quarantine_object", "import_preview", "apply_confirmation", "import_report", "export_job", "deletion_fence"] },
          "command": { "enum": ["select", "insert", "update", "delete"] },
          "runtimeRole": { "enum": ["memory_api_runtime", "memory_worker_runtime", "memory_deletion_runtime"] },
          "sessionContextPresent": { "type": "boolean" },
          "sessionAccountId": { "$ref": "core.v1.schema.json#/$defs/OpaqueId" },
          "sessionEpoch": { "$ref": "core.v1.schema.json#/$defs/AccountEpoch" },
          "rowOwnerAccountId": { "$ref": "core.v1.schema.json#/$defs/OpaqueId" },
          "rowEpoch": { "$ref": "core.v1.schema.json#/$defs/AccountEpoch" },
          "proposedOwnerAccountId": { "$ref": "core.v1.schema.json#/$defs/OpaqueId" },
          "proposedEpoch": { "$ref": "core.v1.schema.json#/$defs/AccountEpoch" },
          "expectedDecision": { "enum": ["allow", "deny"] },
          "expectedIssueCode": { "type": "string", "pattern": "^SEC_[A-Z0-9_]+$", "maxLength": 128 }
        }
      }
    }
  }
}
