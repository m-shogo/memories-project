{
  "$schema": "https://memory-os.example/schemas/memory-town/reset-case-set.v2.schema.json",
  "caseSetId": "memory-town.reset-cases-v2",
  "caseSetVersion": 2,
  "globalRules": {
    "memoryDomainMayBeModified": false,
    "resetRequiresPreview": true,
    "resetRequiresExplicitConfirmation": true,
    "snapshotBeforeApply": true,
    "applyMode": "atomic",
    "defaultUserObjectDisposition": "stored_not_deleted",
    "featureResetCapturesProjectionCursor": true
  },
  "cases": [
    {
      "caseId": "reset-single-feature-progress-v2",
      "command": {
        "commandId": "townreset:user:0190f000-0000-7000-8000-000000000101",
        "type": "reset_feature_progress",
        "featureId": "shelf.movie",
        "expectedResetEpoch": 0,
        "expectedProjectionCursor": "cursor.movie.500",
        "reason": "user_requested_visual_reset"
      },
      "expected": {
        "featureProgressChanges": [
          {
            "featureId": "shelf.movie",
            "maxUnlockedStage": 0,
            "resetEpoch": 1,
            "growthOriginCursor": "cursor.movie.500"
          }
        ],
        "layoutChanged": false,
        "environmentChanged": false,
        "memoryDomainChanged": false,
        "userObjectsDeleted": 0,
        "userObjectsStored": 0
      }
    },
    {
      "caseId": "privacy-reset-feature-v2",
      "command": {
        "commandId": "townreset:user:0190f000-0000-7000-8000-000000000102",
        "type": "privacy_reset_feature",
        "featureId": "shelf.movie",
        "expectedResetEpoch": 1,
        "expectedProjectionCursor": "cursor.movie.510",
        "reason": "privacy_reset",
        "removeBadges": true,
        "removeSemanticOverlays": true,
        "removeFeatureBindings": false
      },
      "expected": {
        "featureProgressChanges": [
          {
            "featureId": "shelf.movie",
            "maxUnlockedStage": 0,
            "resetEpoch": 2,
            "growthOriginCursor": "cursor.movie.510"
          }
        ],
        "badgesRemoved": true,
        "semanticOverlaysRemoved": true,
        "primaryBindingPreserved": true,
        "rawDeletedMemoryRetainedAnywhereInTown": false,
        "memoryDomainChanged": false
      }
    },
    {
      "caseId": "reset-layout-to-template-v2",
      "command": {
        "commandId": "townreset:user:0190f000-0000-7000-8000-000000000103",
        "type": "reset_layout_to_template",
        "expectedLayoutRevision": 14,
        "templateId": "memory-town.main-island.default",
        "templateVersion": 1,
        "userObjectDisposition": "stored"
      },
      "expected": {
        "featureProgressChanged": false,
        "layoutRevisionFrom": 14,
        "layoutRevisionTo": 15,
        "templateObjectsRestored": true,
        "userObjectsDeleted": 0,
        "userObjectsStored": 7,
        "memoryDomainChanged": false
      }
    },
    {
      "caseId": "reset-decorations-only-v2",
      "command": {
        "commandId": "townreset:user:0190f000-0000-7000-8000-000000000104",
        "type": "reset_decorations",
        "expectedLayoutRevision": 20,
        "categories": ["tree", "flower", "ground_decor", "raised_decor", "furniture", "seasonal"],
        "originFilter": ["user"],
        "userObjectDisposition": "stored"
      },
      "expected": {
        "layoutRevisionFrom": 20,
        "layoutRevisionTo": 21,
        "systemStructuresChanged": false,
        "physicalPathsChanged": false,
        "featureProgressChanged": false,
        "userObjectsDeleted": 0,
        "userObjectsStored": 12,
        "memoryDomainChanged": false
      }
    },
    {
      "caseId": "reset-environment-preferences-v2",
      "command": {
        "commandId": "townreset:user:0190f000-0000-7000-8000-000000000105",
        "type": "reset_environment_preferences",
        "themeId": "town-theme.default"
      },
      "expected": {
        "environment": {
          "themeId": "town-theme.default",
          "seasonMode": "auto",
          "timeMode": "day",
          "weatherVisual": "clear",
          "motionLevel": "reduced",
          "soundEnabled": false
        },
        "layoutChanged": false,
        "featureProgressChanged": false,
        "memoryDomainChanged": false
      }
    },
    {
      "caseId": "reset-entire-town-v2",
      "command": {
        "commandId": "townreset:user:0190f000-0000-7000-8000-000000000106",
        "type": "reset_entire_town",
        "expectedLayoutRevision": 30,
        "templateId": "memory-town.main-island.default",
        "templateVersion": 1,
        "featureResetInputs": [
          {
            "featureId": "shelf.movie",
            "expectedResetEpoch": 2,
            "expectedProjectionCursor": "cursor.movie.510"
          },
          {
            "featureId": "shelf.story",
            "expectedResetEpoch": 0,
            "expectedProjectionCursor": "cursor.story.44"
          }
        ],
        "resetEnvironmentPreferences": true,
        "userObjectDisposition": "stored"
      },
      "expected": {
        "layoutRevisionFrom": 30,
        "layoutRevisionTo": 31,
        "environmentReset": true,
        "templateRestored": true,
        "userObjectsDeleted": 0,
        "userObjectsStored": 22,
        "memoryDomainChanged": false,
        "rollbackSnapshotCreated": true
      }
    }
  ]
}
