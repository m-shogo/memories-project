{
  "$schema": "https://memory-os.example/schemas/memory-town/worker-fence-case-set.v1.schema.json",
  "caseSetId": "memory-town.worker-fence-cases",
  "caseSetVersion": 1,
  "cases": [
    {
      "caseId": "projection-worker-active-account-pass",
      "job": {
        "jobId": "townjob:projection:001",
        "jobType": "feature_projection",
        "expectedDeletionEpoch": 4,
        "expectedAccountState": "active"
      },
      "currentFence": {
        "accountState": "active",
        "deletionEpoch": 4,
        "layoutRevision": 12,
        "mutationMode": "normal"
      },
      "expected": {
        "writeAllowed": true,
        "retryAllowed": false,
        "rowsWritten": 1
      }
    },
    {
      "caseId": "snapshot-worker-rejected-after-deletion-request",
