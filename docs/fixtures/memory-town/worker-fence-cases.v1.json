        "expectedAccountState": "active"
      },
      "currentFence": {
        "accountState": "deletion_requested",
        "deletionEpoch": 5,
        "layoutRevision": 12,
        "mutationMode": "normal"
      },
      "expected": {
        "writeAllowed": false,
        "retryAllowed": false,
        "rowsWritten": 0,
        "issueCode": "ACCOUNT_DELETION_FENCE_REJECTED"
      }
    },
    {
      "caseId": "thumbnail-worker-rejected-after-account-deleted",
